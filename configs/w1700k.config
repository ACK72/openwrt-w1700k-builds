# W1700K UBI2, adapted from w1700k/builds user/ubi2-oc/config.diff.
CONFIG_TARGET_airoha=y
CONFIG_TARGET_airoha_an7581=y
CONFIG_TARGET_airoha_an7581_DEVICE_gemtek_w1700k-ubi=y
# These build menus are required to disable host GDB.
CONFIG_DEVEL=y
CONFIG_TOOLCHAINOPTS=y
CONFIG_CCACHE=y
CONFIG_BUILD_LOG=y
CONFIG_REPRODUCIBLE_DEBUG_INFO=y
# Release binaries: retain target defaults needed for BPF/BTF and crash reports.
# CONFIG_DEBUG is not set
# CONFIG_EXPERIMENTAL is not set
# CONFIG_TESTING_KERNEL is not set
# CONFIG_COLLECT_KERNEL_DEBUG is not set
# CONFIG_NO_STRIP is not set
CONFIG_SIGNED_PACKAGES=y
CONFIG_SIGN_EACH_PACKAGE=y
CONFIG_SIGNATURE_CHECK=y
CONFIG_DOWNLOAD_CHECK_CERTIFICATE=y
CONFIG_JSON_OVERVIEW_IMAGE_INFO=y
CONFIG_IMAGEOPT=y
CONFIG_VERSIONOPT=y
CONFIG_VERSION_NUMBER="ubi2-oc"
CONFIG_VERSION_DIST="OpenWrt"
CONFIG_VERSION_FIRMWARE_URL="https://github.com/ACK72/openwrt-w1700k-builds/releases"
# Keep package opt-in LTO and FDK LTO; global LTO increases link RAM/time.
# CONFIG_USE_LTO is not set
# Only build the packages needed by this image, not every kernel module.
# CONFIG_ALL_KMODS is not set
# CONFIG_ALL_NONSHARED is not set
# CONFIG_SDK is not set
# CONFIG_IB is not set
# CONFIG_GDB is not set
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set
# The FDK application in this repository is for MT7996, not MT7992.
# CONFIG_PACKAGE_airoha-en7581-npu-firmware is not set
CONFIG_PACKAGE_airoha-en7581-mt7996-npu-firmware=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl-openssl=y
CONFIG_PACKAGE_luci-app-airoha-flowsense=y
CONFIG_PACKAGE_luci-app-airoha-npu=y
CONFIG_PACKAGE_luci-app-w1700k-fancontrol=y
CONFIG_PACKAGE_luci-app-mlo=y
CONFIG_PACKAGE_luci-app-wifi7=y
CONFIG_PACKAGE_luci-app-irqbalance=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_irqbalance=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_jq=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_nano=y
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
CONFIG_PACKAGE_wpad-openssl=y
CONFIG_KERNEL_BUILD_USER="builder"
CONFIG_KERNEL_BUILD_DOMAIN="buildhost"
