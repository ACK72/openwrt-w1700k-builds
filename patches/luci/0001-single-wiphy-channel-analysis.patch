Subject: [PATCH] luci-mod-status: select active netdev and filter shared radio channels
SPDX-License-Identifier: Apache-2.0
Copyright: 2026 openwrt-w1700k-builds contributors

New implementation against openwrt/luci@3791919f3eee317a59d4bebc5bea14a3fd9c9089.
Problem references:
  https://github.com/openwrt/luci/issues/7483
  https://github.com/w1700k/builds/blob/9449e4ca242ab30278df20940d6654ddc1c102e8/user/default/files/998-single-wiphy.patch
The latter records the original workaround by Gilly1970.
Its patch text is not redistributed here. This independently written change
keeps the LuCI component's Apache-2.0 terms; it is not GPL-2.0-only builder code.

Resolve a usable interface each time a scan runs, preferring an active network.
Filter the frequency list by the configured band before constructing graph tabs.
---
--- a/modules/luci-mod-status/htdocs/luci-static/resources/view/status/channel_analysis.js
+++ b/modules/luci-mod-status/htdocs/luci-static/resources/view/status/channel_analysis.js
@@ -1,3 +1,7 @@
+/* SPDX-License-Identifier: Apache-2.0
+ * Modified by openwrt-w1700k-builds contributors, 2026.
+ * Select the active radio interface for scans and filter shared-wiphy bands.
+ */
 'use strict';
 'require view';
 'require poll';
@@ -21,6 +25,26 @@
 		params: [ 'device' ],
 		expect: { }
 	}),
+
+	scanInterface: rpc.declare({
+		object: 'iwinfo',
+		method: 'scan',
+		params: [ 'device' ],
+		expect: { results: [] }
+	}),
+
+	async readRadio(device) {
+		const networks = await device.getWifiNetworks();
+		const usable = networks.filter(net => net.getIfname());
+		const active = usable.find(net => net.isUp()) || usable[0];
+		const name = active ? active.getIfname() : device.getName();
+		return Promise.all([this.scanInterface(name), this.callInfo(name)]);
+	},
+
+	channelsForRadio(device, channels) {
+		const band = { '2g': 2, '5g': 5, '6g': 6 }[device.get('band')];
+		return band ? channels.filter(channel => Number(channel.band) === band) : channels;
+	},
 
 	render_signal_badge(signalPercent, signalValue) {
 		let icon, title, value;
@@ -200,10 +224,7 @@
 		const radio = this.radios[this.active_tab];
 		let q;
 
-		return Promise.all([
-			radio.dev.getScanList(),
-			this.callInfo(radio.dev.getName())
-		]).then(L.bind(function([results, local_wifi]) {
+		return this.readRadio(radio.dev).then(L.bind(function([results, local_wifi]) {
 			const table = radio.table;
 			const chan_analysis = radio.graph;
 			const scanCache = radio.scanCache;
@@ -446,7 +467,7 @@
 			};
 
 			/* Split FrequencyList in Bands */
-			wifiDevs[ifname].freq.forEach(function(freq) {
+			this.channelsForRadio(wifiDevs[ifname].dev, wifiDevs[ifname].freq).forEach(function(freq) {
 				if (bands[freq.band])
 					bands[freq.band].channels.push(freq.channel);
 			});
