Subject: [PATCH] irqbalance: honor optional W1700K IRQ ownership policy

diff --git a/utils/irqbalance/Makefile b/utils/irqbalance/Makefile
--- a/utils/irqbalance/Makefile
+++ b/utils/irqbalance/Makefile
@@ -6,7 +6,7 @@
 
 PKG_NAME:=irqbalance
 PKG_VERSION:=1.9.5
-PKG_RELEASE:=1
+PKG_RELEASE:=2
 
 PKG_SOURCE_PROTO:=git
 PKG_SOURCE_URL:=https://github.com/Irqbalance/irqbalance.git
diff --git a/utils/irqbalance/files/irqbalance.init b/utils/irqbalance/files/irqbalance.init
--- a/utils/irqbalance/files/irqbalance.init
+++ b/utils/irqbalance/files/irqbalance.init
@@ -32,6 +32,11 @@
 	procd_append_param command "-c $deepestcache"
 	procd_append_param command "-t $interval"
 
+	# The W1700K platform owns Ethernet/Wi-Fi IRQ and NAPI locality together.
+	if [ -x /usr/libexec/w1700k-irq-policy ]; then
+		procd_append_param command --policyscript=/usr/libexec/w1700k-irq-policy
+	fi
+
 	# add banned IRQs
 	handle_banirq_value()
 	{
