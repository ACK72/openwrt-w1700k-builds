Subject: [PATCH] runtime: provide the compiler-generated memmove entry point
SPDX-License-Identifier: MIT

Clang 18 LTO emits a memmove call in the MT7996 PPE result lifecycle. The
freestanding image has no libc, so export the standard entry point alongside
memcpy and memset, delegating to the existing overlap-safe implementation.
Keep the host-test guard used by the other standard memory functions.

diff --git a/include/an7581/runtime/memory.h b/include/an7581/runtime/memory.h
index a0152ac..e240b77 100644
--- a/include/an7581/runtime/memory.h
+++ b/include/an7581/runtime/memory.h
@@ -11,6 +11,7 @@ void *npu_memmove(void *destination, const void *source, size_t length);
 #ifndef AN7581_MMIO_TEST
 void *memset(void *destination, int value, size_t length);
 void *memcpy(void *destination, const void *source, size_t length);
+void *memmove(void *destination, const void *source, size_t length);
 #endif
 
 #endif
diff --git a/src/an7581/runtime/memory.c b/src/an7581/runtime/memory.c
index 6e7c72f..9c12ebb 100644
--- a/src/an7581/runtime/memory.c
+++ b/src/an7581/runtime/memory.c
@@ -46,4 +46,8 @@ void *memset(void *destination, int value, size_t length) {
 void *memcpy(void *destination, const void *source, size_t length) {
   return npu_memcpy(destination, source, length);
 }
+
+void *memmove(void *destination, const void *source, size_t length) {
+  return npu_memmove(destination, source, length);
+}
 #endif
