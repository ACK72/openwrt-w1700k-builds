Subject: [PATCH] wifi: retain volatile accesses around assume_aligned
SPDX-License-Identifier: MIT

Clang 18 rejects implicit conversion of volatile pointers to the const void *
argument of __builtin_assume_aligned when building with -Werror.
Cast only the address passed to the builtin. The receiving pointers and all
actual packet reads/writes retain their original volatile qualification.

diff --git a/src/an7581/services/wifi/mt7996_packet_control.c b/src/an7581/services/wifi/mt7996_packet_control.c
index b60b512..ba0a8bb 100644
--- a/src/an7581/services/wifi/mt7996_packet_control.c
+++ b/src/an7581/services/wifi/mt7996_packet_control.c
@@ -53,8 +53,8 @@ enum npu_runtime_result npu_wifi_mt7996_packet_control_enqueue(
     return NPU_RUNTIME_OUT_OF_RANGE;
 
   packet_control = __builtin_assume_aligned(
-      control->packet_mapping +
-          (uint32_t)packet_id * NPU_WIFI_MT7996_PACKET_CONTROL_PACKET_STRIDE,
+      (const void *)(control->packet_mapping +
+          (uint32_t)packet_id * NPU_WIFI_MT7996_PACKET_CONTROL_PACKET_STRIDE),
       sizeof(uint32_t));
   packet_length = (uint16_t)((*packet_control & UINT32_C(0x1ffff)) >> 3U);
   return control->enqueue(
diff --git a/src/an7581/services/wifi/mt7996_packet_queue_consumer.c b/src/an7581/services/wifi/mt7996_packet_queue_consumer.c
index 83883a1..246ff9e 100644
--- a/src/an7581/services/wifi/mt7996_packet_queue_consumer.c
+++ b/src/an7581/services/wifi/mt7996_packet_queue_consumer.c
@@ -144,7 +144,8 @@ static void process_valid_entry(
   uint16_t packet_id = (uint16_t)entry->packet_id;
 
   packet_words = __builtin_assume_aligned(
-      consumer->packet_cached_memory + packet_offset, sizeof(uint32_t));
+      (const void *)(consumer->packet_cached_memory + packet_offset),
+      sizeof(uint32_t));
   delivery = (struct npu_wifi_mt7996_packet_delivery){
       .source_device_address = packet_device_address(consumer, packet_id),
       .packet_word = *packet_words,
diff --git a/src/an7581/services/wifi/mt7996_tx_done.c b/src/an7581/services/wifi/mt7996_tx_done.c
index 172d9fc..3da9be3 100644
--- a/src/an7581/services/wifi/mt7996_tx_done.c
+++ b/src/an7581/services/wifi/mt7996_tx_done.c
@@ -317,8 +317,9 @@ npu_wifi_mt7996_tx_done_process(struct npu_wifi_mt7996_tx_done *tx_done,
     packet_offset =
         (uint32_t)old_packet_id * NPU_WIFI_MT7996_TX_DONE_PACKET_SIZE;
     record_words =
-        __builtin_assume_aligned(tx_done->packet_device_memory + packet_offset +
-                                     NPU_WIFI_MT7996_TX_DONE_RECORD_OFFSET,
+        __builtin_assume_aligned((const void *)(tx_done->packet_device_memory +
+                                     packet_offset +
+                                     NPU_WIFI_MT7996_TX_DONE_RECORD_OFFSET),
                                  sizeof(uint32_t));
     record_address = packet_device_address(
         tx_done, old_packet_id, NPU_WIFI_MT7996_TX_DONE_RECORD_OFFSET);
@@ -355,7 +356,8 @@ npu_wifi_mt7996_tx_done_process(struct npu_wifi_mt7996_tx_done *tx_done,
                     NPU_WIFI_MT7996_TX_DONE_PACKET_LENGTH_SHIFT) &
                    NPU_WIFI_MT7996_TX_DONE_PACKET_LENGTH_MASK);
     packet_control = __builtin_assume_aligned(
-        tx_done->packet_cached_memory + packet_offset, sizeof(uint32_t));
+        (const void *)(tx_done->packet_cached_memory + packet_offset),
+        sizeof(uint32_t));
     *packet_control = NPU_WIFI_MT7996_TX_DONE_PACKET_MARKER |
                       ((uint32_t)completion.packet_length
                        << NPU_WIFI_MT7996_TX_DONE_PACKET_MARKER_SHIFT);
diff --git a/src/an7581/services/wifi/rro_packet_backend.c b/src/an7581/services/wifi/rro_packet_backend.c
index 4669b36..08227ad 100644
--- a/src/an7581/services/wifi/rro_packet_backend.c
+++ b/src/an7581/services/wifi/rro_packet_backend.c
@@ -35,9 +35,9 @@ static enum npu_runtime_result write_control(void *context, uint16_t buffer_id,
   if ((uint32_t)buffer_id >= backend->buffer_count)
     return NPU_RUNTIME_OUT_OF_RANGE;
 
-  control = __builtin_assume_aligned(backend->packet_mapping +
+  control = __builtin_assume_aligned((const void *)(backend->packet_mapping +
                                          (uint32_t)buffer_id *
-                                             NPU_WIFI_RRO_PACKET_BUFFER_STRIDE,
+                                             NPU_WIFI_RRO_PACKET_BUFFER_STRIDE),
                                      sizeof(uint32_t));
   *control = packet_control;
   return NPU_RUNTIME_SUCCESS;
diff --git a/src/an7581/services/wifi/rro_page_backend.c b/src/an7581/services/wifi/rro_page_backend.c
index 67b463f..ee51f01 100644
--- a/src/an7581/services/wifi/rro_page_backend.c
+++ b/src/an7581/services/wifi/rro_page_backend.c
@@ -87,11 +87,14 @@ map_page(void *context, uint32_t page_address,
 
   record_page = backend->record_mapping + offset;
   trailer_page = backend->trailer_mapping + offset;
-  view->records = __builtin_assume_aligned(record_page, sizeof(uint32_t));
+  view->records =
+      __builtin_assume_aligned((const void *)record_page, sizeof(uint32_t));
   view->next_page_address =
-      __builtin_assume_aligned(trailer_page + UINT32_C(0x78), sizeof(uint32_t));
+      __builtin_assume_aligned((const void *)(trailer_page + UINT32_C(0x78)),
+                               sizeof(uint32_t));
   view->readiness =
-      __builtin_assume_aligned(trailer_page + UINT32_C(0x7c), sizeof(uint32_t));
+      __builtin_assume_aligned((const void *)(trailer_page + UINT32_C(0x7c)),
+                               sizeof(uint32_t));
   return NPU_RUNTIME_SUCCESS;
 }
 
diff --git a/src/an7581/services/wifi/tx_packet_slow_path.c b/src/an7581/services/wifi/tx_packet_slow_path.c
index 681762e..35c8f95 100644
--- a/src/an7581/services/wifi/tx_packet_slow_path.c
+++ b/src/an7581/services/wifi/tx_packet_slow_path.c
@@ -203,7 +203,7 @@ static bool input_descriptor_is_valid(
 static void patch_record_token(volatile uint8_t *staging_memory,
                                uint32_t staging_offset, uint16_t token_id) {
   volatile struct npu_wifi_tx_buffer_space_record *record =
-      __builtin_assume_aligned(staging_memory + staging_offset,
+      __builtin_assume_aligned((const void *)(staging_memory + staging_offset),
                                sizeof(uint32_t));
   uint32_t token_control = record->token_control;
 
