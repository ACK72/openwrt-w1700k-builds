+// CPU is independent of the optional ping service. Reuse a within-second
+// result instead of converting a zero interval into 0% on a second dashboard.
+function cpu_sample() {
+	const path = '/tmp/flowsense-cpu.json';
+	const line = match(readfile('/proc/stat') ?? '', /^cpu\s+([^\n]+)/);
+	if (!line) return { pct: null };
+	const c = map(split(trim(line[1]), /\s+/), v => +v);
+	let total = 0;
+	for (let i = 0; i < 8; i++) total += c[i] ?? 0;
+	const idle = c[3] + c[4], now = time();
+	let prev;
+	try { prev = json(readfile(path)); } catch (e) { }
+	if (prev && now == prev.time && total >= prev.total) return prev;
+	let pct = null;
+	if (prev && now > prev.time && now - prev.time <= 30 && total > prev.total && idle >= prev.idle)
+		pct = max(0, min(100, int(100.0 * (total - prev.total - idle + prev.idle) / (total - prev.total))));
+	const result = { time: now, total, idle, pct };
+	writefile(path, sprintf('%J', result));
+	return result;
+}
