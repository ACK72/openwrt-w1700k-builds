+			const pse_ports = [];
+			for (let i = 0; i < 10; i++)
+				push(pse_ports, {
+					port: i,
+					iq: (v[i] >> 16) & 0xFFFF,
+					oq: v[i] & 0xFFFF,
+					drops: v[10 + i]
