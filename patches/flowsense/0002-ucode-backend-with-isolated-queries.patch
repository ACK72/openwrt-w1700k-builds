+const PPE_BIND = '/sys/kernel/debug/ppe/bind';
+const PPE_ENTRIES = '/sys/kernel/debug/ppe/entries';
+const PHY_DBG = '/sys/kernel/debug/ieee80211/phy0';
+const JITTER_FILE = '/tmp/npu-jitter.json';
