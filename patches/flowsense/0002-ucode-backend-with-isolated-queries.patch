+get_wifi_stats() {
+	# Collect per-band station stats from all AP interfaces using iw.
+	# MT7996 appears as a single phy0 with sub-interfaces (phy0.0-ap0,
+	# phy0.1-ap0, phy0.2-ap0), so we loop over interfaces and detect
+	# each one's actual operating frequency to classify its band.
+
+	if ! command -v iw > /dev/null 2>&1; then
+		echo '{"available":false,"bands":[]}'
+		return
+	fi
+
+	# Find all AP interfaces
+	local all_ifaces
+	all_ifaces=$(iw dev 2>/dev/null | awk '/Interface/{iface=$2} /type AP/{print iface}')
+
+	[ -z "$all_ifaces" ] && { printf '{"available":true,"bands":[]}'; return; }
+
+	# Accumulate station dumps and interface names per band index (0=2.4G, 1=5G, 2=6G)
+	local dump0="" dump1="" dump2=""
+	local ifaces0="" ifaces1="" ifaces2=""
+	# Per-band uplink rx_fragments (MLO: summed across each band's link-N dirs).
+	local rxfrag0=0 rxfrag1=0 rxfrag2=0
+	local is_mld=0   # set when an MLO (*-mld*) AP interface is present
+
+	for iface in $all_ifaces; do
+		# MLO/MLD interface (e.g. ap-mld0): an MLD spans all bands under a
+		# single netdev, so the phyX.N-apY name trick and the single-channel
+		# frequency fallback don't apply. Classify each station by its
+		# per-link debugfs instead (link-0/1/2 = 2.4/5/6 GHz on MT7996).
+		case "$iface" in
+		*-mld*)
+			is_mld=1
+			local mdbg="/sys/kernel/debug/ieee80211/phy0/netdev:${iface}/stations"
+			local mfull b s bmacs bd frag
+			mfull=$(iw dev "$iface" station dump 2>/dev/null)
+			for b in 0 1 2; do
+				case "$b" in
+					0) ifaces0="${ifaces0} ${iface}" ;;
+					1) ifaces1="${ifaces1} ${iface}" ;;
+					2) ifaces2="${ifaces2} ${iface}" ;;
+				esac
+				bmacs=""; frag=0
+				[ -d "$mdbg" ] && for s in "$mdbg"/*/; do
+					if [ -d "${s}link-${b}" ]; then
+						bmacs="${bmacs} $(basename "$s")"
+						frag=$((frag + $(cat "${s}link-${b}/rx_fragments" 2>/dev/null || echo 0)))
+					fi
+				done
+				case "$b" in 0) rxfrag0=$frag ;; 1) rxfrag1=$frag ;; 2) rxfrag2=$frag ;; esac
+				[ -z "$bmacs" ] && continue
+				# Keep the MLD station visible on every linked band for
+				# counts/signal/rate, but STRIP its byte counters: iw shows one
+				# MLD-aggregate value which would double-count into every band.
+				# Per-band throughput for MLD traffic comes from the hw_
+				# fields (MIB + fw stats) computed below instead.
+				bd=$(printf '%s\n' "$mfull" | awk -v macs="$bmacs" '
+					BEGIN { n = split(macs, a, " "); for (i = 1; i <= n; i++) want[tolower(a[i])] = 1 }
+					/^Station/ { keep = (tolower($2) in want) }
+					keep && /(tx|rx) bytes:/ { next }
+					keep && /(tx|rx) duration:/ { next }
+					keep { print }')
+				case "$b" in
+					0) dump0="${dump0}
+${bd}" ;;
+					1) dump1="${dump1}
+${bd}" ;;
+					2) dump2="${dump2}
+${bd}" ;;
+				esac
+			done
+			continue
+			;;
+		esac
+
+		# Determine band index.
+		# Primary: parse interface name (phyX.N-apY → N is band index:
+		#   0=2.4 GHz, 1=5 GHz, 2=6 GHz on MT7996).
+		# Fallback: read operating frequency from iw dev info.
+		local band_idx
+		band_idx=$(printf '%s' "$iface" | sed -n 's/^[^.]*\.\([0-9][0-9]*\)-.*/\1/p')
+
+		if [ -z "$band_idx" ]; then
+			local freq
+			freq=$(iw dev "$iface" info 2>/dev/null | grep 'channel' | \
+				grep -oE '[0-9]+' | awk '$0+0>1000{print $0+0; exit}')
+			if [ -z "$freq" ] || [ "$freq" -le 0 ] 2>/dev/null; then
+				continue
+			elif [ "$freq" -ge 5925 ]; then
+				band_idx=2
+			elif [ "$freq" -ge 5000 ]; then
+				band_idx=1
+			else
+				band_idx=0
+			fi
+		fi
+
+		# Always register interface for tx_bytes tracking (independent of client state)
+		case "$band_idx" in
+			0) ifaces0="${ifaces0} ${iface}" ;;
+			1) ifaces1="${ifaces1} ${iface}" ;;
+			2) ifaces2="${ifaces2} ${iface}" ;;
+		esac
+
+		# Standard (non-MLO) per-band uplink rx_fragments. Each band is its own
+		# AP netdev and the station's rx_fragments sits DIRECTLY under
+		# stations/<MAC>/ (no link-N subdir, unlike the MLD case above). Sum this
+		# iface's clients into the band total so the gauge's uplink half lights up
+		# on a standard 3-radio setup too. Additive — MLO path unaffected.
+		local sdbg="/sys/kernel/debug/ieee80211/phy0/netdev:${iface}/stations"
+		local ss sfrag=0
+		[ -d "$sdbg" ] && for ss in "$sdbg"/*/; do
+			[ -f "${ss}rx_fragments" ] && sfrag=$((sfrag + $(cat "${ss}rx_fragments" 2>/dev/null || echo 0)))
+		done
+		case "$band_idx" in
+			0) rxfrag0=$((rxfrag0 + sfrag)) ;;
+			1) rxfrag1=$((rxfrag1 + sfrag)) ;;
+			2) rxfrag2=$((rxfrag2 + sfrag)) ;;
+		esac
+
+		# Station dump for client stats — skip band if no clients
+		local d
+		d=$(iw dev "$iface" station dump 2>/dev/null)
+		[ -z "$d" ] && continue
+
+		case "$band_idx" in
+			0) dump0="${dump0}
+${d}" ;;
+			1) dump1="${dump1}
+${d}" ;;
+			2) dump2="${dump2}
+${d}" ;;
+		esac
+	done
+
+	# Compute per-band TX throughput from mac80211 per-station tx bytes.
+	# The sysfs netdev tx_bytes counter is bypassed by MT7996 HW DMA.
+	# iw station dump 'tx bytes:' comes from mac80211 per-sta counters
+	# which are updated before frames enter the hardware TX queue.
+	local now; now=$(date +%s 2>/dev/null || awk '{printf "%d",$1}' /proc/uptime)
+
+	# Per-band tx+rx byte totals (mac80211 per-sta counters via iw). expected
+	# throughput reads 0 on MT7996 fw, so the gauge needle is driven from these
+	# real byte deltas instead. Both directions so uploads light the gauge too.
+	local sta_tx0 sta_tx1 sta_tx2 sta_rx0 sta_rx1 sta_rx2
+	sta_tx0=$(printf '%s\n' "$dump0" | awk '/tx bytes:/{t+=$NF} END{printf "%d",t+0}')
+	sta_tx1=$(printf '%s\n' "$dump1" | awk '/tx bytes:/{t+=$NF} END{printf "%d",t+0}')
+	sta_tx2=$(printf '%s\n' "$dump2" | awk '/tx bytes:/{t+=$NF} END{printf "%d",t+0}')
+	sta_rx0=$(printf '%s\n' "$dump0" | awk '/rx bytes:/{t+=$NF} END{printf "%d",t+0}')
+	sta_rx1=$(printf '%s\n' "$dump1" | awk '/rx bytes:/{t+=$NF} END{printf "%d",t+0}')
+	sta_rx2=$(printf '%s\n' "$dump2" | awk '/rx bytes:/{t+=$NF} END{printf "%d",t+0}')
+
+	# awk reads OLD prev_file and computes Mbps deltas before we overwrite it.
+	# prev format: now tx0 tx1 tx2 rx0 rx1 rx2  (7 fields; older 4-field files
+	# just skip the rx delta for one poll)
+	local _rates
+	_rates=$(awk -v now="$now" \
+		-v t0="$sta_tx0" -v t1="$sta_tx1" -v t2="$sta_tx2" \
+		-v r0="$sta_rx0" -v r1="$sta_rx1" -v r2="$sta_rx2" \
+		'BEGIN {
+			pf = "/tmp/npu-wifi-bytes.prev"
+			tx0="0.0"; tx1="0.0"; tx2="0.0"; rx0="0.0"; rx1="0.0"; rx2="0.0"
+			if ((getline line < pf) > 0) {
+				n = split(line, a)
+				pt = a[1]+0; dt = now - pt
+				if (pt > 0 && now > pt) {
+					d=t0-a[2]; if(d<0)d=0; tx0=sprintf("%.1f", d/dt/125000)
+					d=t1-a[3]; if(d<0)d=0; tx1=sprintf("%.1f", d/dt/125000)
+					d=t2-a[4]; if(d<0)d=0; tx2=sprintf("%.1f", d/dt/125000)
+					if (n >= 7) {
+						d=r0-a[5]; if(d<0)d=0; rx0=sprintf("%.1f", d/dt/125000)
+						d=r1-a[6]; if(d<0)d=0; rx1=sprintf("%.1f", d/dt/125000)
+						d=r2-a[7]; if(d<0)d=0; rx2=sprintf("%.1f", d/dt/125000)
+					}
+				}
+			}
+			printf "%s %s %s %s %s %s\n", tx0, tx1, tx2, rx0, rx1, rx2
+		}' /dev/null)
+	echo "$now $sta_tx0 $sta_tx1 $sta_tx2 $sta_rx0 $sta_rx1 $sta_rx2" > /tmp/npu-wifi-bytes.prev
+	local tx0_mbps tx1_mbps tx2_mbps rx0_mbps rx1_mbps rx2_mbps
+	tx0_mbps=$(echo "$_rates" | awk '{print $1}')
+	tx1_mbps=$(echo "$_rates" | awk '{print $2}')
+	tx2_mbps=$(echo "$_rates" | awk '{print $3}')
+	rx0_mbps=$(echo "$_rates" | awk '{print $4}')
+	rx1_mbps=$(echo "$_rates" | awk '{print $5}')
+	rx2_mbps=$(echo "$_rates" | awk '{print $6}')
+
+	# HW (offload-surviving) per-band byte rates — exact where available:
+	#  - hwrx (uplink): per-band MAC MIB rx_ampdu_bytes (mt76 band_bytes debugfs,
+	#    driver patch 041). Counts at the MAC: sees NPU/WED-offloaded traffic AND
+	#    every link of an MLD station. u32 accumulators -> modular delta.
+	#  - hwtx (downlink): sum of per-station fw ADM tx_bytes ('stats' debugfs,
+	#    driver patches 038/039). Exact for normal stations and an MLD's setup
+	#    link; the fw does not account an MLD's secondary-link DL (air_mbps
+	#    remains the fallback for that case). Legacy clients on an MLD SSID have
+	#    no per-band path and are skipped here (covered by iw exact + air est).
+	local hwrx0=0 hwrx1=0 hwrx2=0 hwtx0=0 hwtx1=0 hwtx2=0
+	local BB=/sys/kernel/debug/ieee80211/phy0/mt76/band_bytes
+	if [ -r "$BB" ]; then
+		local mib_cur stx0=0 stx1=0 stx2=0 sf sv sb
+		mib_cur=$(awk '/Phy band/{b=$3} /rx_ampdu_bytes:/{v[b]=$2} END{printf "%.0f %.0f %.0f", v[0]+0, v[1]+0, v[2]+0}' "$BB" 2>/dev/null)
+		for sf in /sys/kernel/debug/ieee80211/phy0/netdev:*/stations/*/stats \
+			  /sys/kernel/debug/ieee80211/phy0/netdev:*/stations/*/link-*/stats; do
+			[ -r "$sf" ] || continue
+			case "$sf" in
+				*/link-0/stats) sb=0 ;;
+				*/link-1/stats) sb=1 ;;
+				*/link-2/stats) sb=2 ;;
+				*netdev:phy0.0-*) sb=0 ;;
+				*netdev:phy0.1-*) sb=1 ;;
+				*netdev:phy0.2-*) sb=2 ;;
+				*) continue ;;
+			esac
+			sv=$(awk '/^tx_bytes:/{print $2}' "$sf" 2>/dev/null)
+			case "$sb" in
+				0) stx0=$((stx0 + ${sv:-0})) ;;
+				1) stx1=$((stx1 + ${sv:-0})) ;;
+				2) stx2=$((stx2 + ${sv:-0})) ;;
+			esac
+		done
+		local _hw
+		_hw=$(awk -v now="$now" -v m="$mib_cur" -v t0="$stx0" -v t1="$stx1" -v t2="$stx2" '
+			BEGIN {
+				pf = "/tmp/npu-wifi-hwbytes.prev"
+				r0="0.0"; r1="0.0"; r2="0.0"; x0="0.0"; x1="0.0"; x2="0.0"
+				split(m, c)
+				have = ((getline line < pf) > 0)
+				close(pf)
+				if (have) {
+					n = split(line, a); pt = a[1]+0; dt = now - pt
+					if (pt > 0 && now <= pt) {
+						# same-second duplicate/concurrent call: replay the
+						# stored rates WITHOUT moving the baseline, so a
+						# double-polling frontend does not read 0 and reset
+						# the delta window every tick.
+						if (n >= 13) { r0=a[8]; r1=a[9]; r2=a[10]; x0=a[11]; x1=a[12]; x2=a[13] }
+						printf "%s %s %s %s %s %s\n", r0, r1, r2, x0, x1, x2
+						exit
+					}
+					if (pt > 0 && now > pt) {
+						for (b = 0; b < 3; b++) {
+							d = c[b+1] - a[2+b]
+							if (d < 0) d += 4294967296       # u32 wrap
+							if (d < 0 || d > 2147483648) d = 0   # sanity
+							mb[b] = d * 8 / dt / 1000000
+						}
+						r0=sprintf("%.1f",mb[0]); r1=sprintf("%.1f",mb[1]); r2=sprintf("%.1f",mb[2])
+						d=t0-a[5]; if(d<0)d=0; x0=sprintf("%.1f", d*8/dt/1000000)
+						d=t1-a[6]; if(d<0)d=0; x1=sprintf("%.1f", d*8/dt/1000000)
+						d=t2-a[7]; if(d<0)d=0; x2=sprintf("%.1f", d*8/dt/1000000)
+					}
+				}
+				printf "%d %.0f %.0f %.0f %.0f %.0f %.0f %s %s %s %s %s %s\n", now, c[1]+0, c[2]+0, c[3]+0, t0, t1, t2, r0, r1, r2, x0, x1, x2 > pf
+				printf "%s %s %s %s %s %s\n", r0, r1, r2, x0, x1, x2
+			}' /dev/null)
+		hwrx0=$(echo "$_hw"|awk '{print $1}'); hwrx1=$(echo "$_hw"|awk '{print $2}'); hwrx2=$(echo "$_hw"|awk '{print $3}')
+		hwtx0=$(echo "$_hw"|awk '{print $4}'); hwtx1=$(echo "$_hw"|awk '{print $5}'); hwtx2=$(echo "$_hw"|awk '{print $6}')
+	fi
+
+	# Per-band Tx PER (packet error rate) from mt76 debugfs — the consistent
+	# per-MPDU hardware error metric. Surfaced below as retry_pct because the
+	# station-dump ratio (per-MPDU tx_retries vs per-MSDU tx_packets) over-reads
+	# 2-5x on EHT/6 GHz and isn't a real health signal.
+	local band_per_0=0 band_per_1=0 band_per_2=0
+	local band_txok_0=0 band_txok_1=0 band_txok_2=0
+	eval "$(awk '
+		/Phy band [0-9]/ { b = $NF + 0 }
+		/Tx PER:/ { v = $3; gsub(/%/, "", v); if (b >= 0 && b <= 2) printf "band_per_%d=%d;", b, v + 0 }
+		/Tx success:/ { if (b >= 0 && b <= 2) printf "band_txok_%d=%.0f;", b, $3 + 0 }
+	' /sys/kernel/debug/ieee80211/phy0/mt76/tx_stats 2>/dev/null)"
+
+	# Per-band total frame rate (frames/s): downlink Tx-success MPDUs (mt76 tx_stats,
+	# per Phy band, survives NPU offload) + uplink rx_fragments (per link). Drives the
+	# MLO per-band frames arc + BND glow (offload hides bytes, not frames).
+	local fcur0=$((band_txok_0 + rxfrag0)) fcur1=$((band_txok_1 + rxfrag1)) fcur2=$((band_txok_2 + rxfrag2))
+	local _fps frames0 frames1 frames2
+	_fps=$(awk -v now="$now" -v c0="$fcur0" -v c1="$fcur1" -v c2="$fcur2" '
+		BEGIN {
+			pf = "/tmp/npu-wifi-frames.prev"
+			f0="0"; f1="0"; f2="0"
+			if ((getline line < pf) > 0) {
+				n = split(line, a); pt = a[1]+0; dt = now - pt
+				if (pt > 0 && now > pt) {
+					d=c0-a[2]; if(d<0)d=0; f0=sprintf("%d", d/dt)
+					d=c1-a[3]; if(d<0)d=0; f1=sprintf("%d", d/dt)
+					d=c2-a[4]; if(d<0)d=0; f2=sprintf("%d", d/dt)
+				}
+			}
+			printf "%s %s %s\n", f0, f1, f2
+		}' /dev/null)
+	echo "$now $fcur0 $fcur1 $fcur2" > /tmp/npu-wifi-frames.prev
+	frames0=$(echo "$_fps" | awk '{print $1}')
+	frames1=$(echo "$_fps" | awk '{print $2}')
+	frames2=$(echo "$_fps" | awk '{print $3}')
+
+	# Per-band OFFLOADED throughput estimate from radio AIRTIME. Airtime survives NPU
+	# offload (the MAC spends airtime on every frame regardless of who bridges it),
+	# unlike the byte counters the NPU bypasses. Per band bytes ~= duration*bitrate,
+	# deltaed over the poll interval, * efficiency to approximate goodput (retries +
+	# PHY/MAC overhead). tx/rx duration + bitrate come from the station dumps already
+	# collected above (no extra iw calls). Frontend uses this when a band is offloaded
+	# (BND>0), the exact mac80211 byte-rate otherwise.
+	#
+	# EFFICIENCY IS AUTO-CALIBRATED per band: whenever a band carries real traffic but
+	# is NOT offloaded (BND==0), the exact byte-rate IS the true throughput, so
+	# exact/raw-airtime = the live efficiency for that band's RF/rate/retry conditions.
+	# EMA-learn it and apply it when the band offloads. `npu-monitor.settings.air_eff`
+	# (default 80) is the SEED/fallback until a band has a calibration sample.
+	local AIR_EFF; AIR_EFF=$(uci -q get npu-monitor.settings.air_eff 2>/dev/null)
+	case "$AIR_EFF" in ''|*[!0-9]*) AIR_EFF=80 ;; esac
+	{ [ "$AIR_EFF" -ge 1 ] && [ "$AIR_EFF" -le 200 ]; } 2>/dev/null || AIR_EFF=80
+	local a0 a1 a2
+	_airsum() { printf '%s\n' "$1" | awk '
+		/tx duration:/{td+=$3+0} /rx duration:/{rd+=$3+0}
+		/tx bitrate:/{tr+=$3+0;trn++} /rx bitrate:/{rr+=$3+0;rrn++}
+		END{printf "%.0f %.0f %.1f %.1f", td+0, rd+0, (trn?tr/trn:0), (rrn?rr/rrn:0)}'; }
+	a0=$(_airsum "$dump0"); a1=$(_airsum "$dump1"); a2=$(_airsum "$dump2")
+	# Per-band BND count (gates auto-calibration to non-offloaded bands). Reuse client
+	# MACs from the dumps + the bind table (same match as getPpeEntries).
+	local bn0=0 bn1=0 bn2=0
+	if [ -f /sys/kernel/debug/ppe/bind ]; then
+		local pm0 pm1 pm2 _bn
+		pm0=$(printf '%s\n' "$dump0" | awk '/^Station/{print $2}' | tr '\n' '|' | sed 's/|$//')
+		pm1=$(printf '%s\n' "$dump1" | awk '/^Station/{print $2}' | tr '\n' '|' | sed 's/|$//')
+		pm2=$(printf '%s\n' "$dump2" | awk '/^Station/{print $2}' | tr '\n' '|' | sed 's/|$//')
+		_bn=$(awk -v m0="$pm0" -v m1="$pm1" -v m2="$pm2" '
+			function has(macs, eth,   n,arr,i,low){ if(macs=="")return 0; low=tolower(eth); n=split(macs,arr,"|"); for(i=1;i<=n;i++) if(arr[i]!=""&&index(low,tolower(arr[i]))>0)return 1; return 0 }
+			/^[0-9a-fA-F]+ BND /{ eth=""; match($0,/eth=[^ \t]+/); if(RSTART>0)eth=substr($0,RSTART+4,RLENGTH-4); if(has(m0,eth))c0++; if(has(m1,eth))c1++; if(has(m2,eth))c2++ }
+			END{printf "%d %d %d", c0+0,c1+0,c2+0}' /sys/kernel/debug/ppe/bind 2>/dev/null)
+		bn0=$(echo "$_bn"|awk '{print $1}'); bn1=$(echo "$_bn"|awk '{print $2}'); bn2=$(echo "$_bn"|awk '{print $3}')
+	fi
+	local _air
+	_air=$(awk -v now="$now" -v seed="$AIR_EFF" -v a0="$a0" -v a1="$a1" -v a2="$a2" \
+		-v tx0="$tx0_mbps" -v rx0="$rx0_mbps" -v tx1="$tx1_mbps" -v rx1="$rx1_mbps" -v tx2="$tx2_mbps" -v rx2="$rx2_mbps" \
+		-v bn0="$bn0" -v bn1="$bn1" -v bn2="$bn2" '
+		BEGIN {
+			split(a0,x0); split(a1,x1); split(a2,x2)
+			ctd[0]=x0[1]+0; crd[0]=x0[2]+0; btr[0]=x0[3]+0; brr[0]=x0[4]+0
+			ctd[1]=x1[1]+0; crd[1]=x1[2]+0; btr[1]=x1[3]+0; brr[1]=x1[4]+0
+			ctd[2]=x2[1]+0; crd[2]=x2[2]+0; btr[2]=x2[3]+0; brr[2]=x2[4]+0
+			ex[0]=tx0+rx0; ex[1]=tx1+rx1; ex[2]=tx2+rx2
+			bn[0]=bn0+0; bn[1]=bn1+0; bn[2]=bn2+0
+			seedf=seed/100; if(seedf<0.3)seedf=0.3; if(seedf>1)seedf=1
+			FLOOR=15; ALPHA=0.25   # need >15 Mbps raw airtime to sample; EMA weight 0.25
+			for (b=0;b<3;b++) { eff[b]=seedf; air[b]="0.0" }
+			pf="/tmp/npu-wifi-airtime.prev"
+			if ((getline line < pf) > 0) {
+				n=split(line,p); pt=p[1]+0; dt=now-pt
+				for (b=0;b<3;b++) { e=p[9+b]+0; if(e>=0.3 && e<=1.0) eff[b]=e }   # learned eff from state
+				if (pt>0 && now>pt) {
+					for (b=0;b<3;b++) {
+						dtd=ctd[b]-p[2+b]; if(dtd<0)dtd=0
+						drd=crd[b]-p[5+b]; if(drd<0)drd=0
+						raw=(dtd*btr[b] + drd*brr[b])/1000000/dt   # Mbps, no efficiency factor
+						if (raw != raw || raw > 20000) raw=0       # guard NaN / counter-wrap spikes
+						if (bn[b]==0 && raw>FLOOR && ex[b]>FLOOR) {   # calibrate only on non-offloaded traffic
+							s=ex[b]/raw
+							if (s>=0.3 && s<=1.0) eff[b]=eff[b]*(1-ALPHA) + s*ALPHA
+						}
+						air[b]=sprintf("%.1f", raw*eff[b])
+					}
+				}
+			}
+			close(pf)
+			printf "%.0f %.0f %.0f %.0f %.0f %.0f %.0f %.3f %.3f %.3f\n", now, ctd[0],ctd[1],ctd[2],crd[0],crd[1],crd[2], eff[0],eff[1],eff[2] > pf
+			printf "%s %s %s %.0f %.0f %.0f\n", air[0],air[1],air[2], eff[0]*100,eff[1]*100,eff[2]*100
+		}' /dev/null)
+	local air0 air1 air2 aireff0 aireff1 aireff2
+	air0=$(echo "$_air"|awk '{print $1}'); air1=$(echo "$_air"|awk '{print $2}'); air2=$(echo "$_air"|awk '{print $3}')
+	aireff0=$(echo "$_air"|awk '{print $4}'); aireff1=$(echo "$_air"|awk '{print $5}'); aireff2=$(echo "$_air"|awk '{print $6}')
+
+	local bands_json=""
+	for band_idx in 0 1 2; do
+		local dump tx_mbps rx_mbps band_per frames_ps air_mbps air_eff hw_tx hw_rx
+		case "$band_idx" in
+			0) dump="$dump0"; tx_mbps="$tx0_mbps"; rx_mbps="$rx0_mbps"; band_per="$band_per_0"; frames_ps="$frames0"; air_mbps="$air0"; air_eff="$aireff0"; hw_tx="$hwtx0"; hw_rx="$hwrx0" ;;
+			1) dump="$dump1"; tx_mbps="$tx1_mbps"; rx_mbps="$rx1_mbps"; band_per="$band_per_1"; frames_ps="$frames1"; air_mbps="$air1"; air_eff="$aireff1"; hw_tx="$hwtx1"; hw_rx="$hwrx1" ;;
+			2) dump="$dump2"; tx_mbps="$tx2_mbps"; rx_mbps="$rx2_mbps"; band_per="$band_per_2"; frames_ps="$frames2"; air_mbps="$air2"; air_eff="$aireff2"; hw_tx="$hwtx2"; hw_rx="$hwrx2" ;;
+		esac
+		[ -z "$dump" ] && continue
+
+		local stats
+		stats=$(echo "$dump" | awk -v band_per="${band_per:-0}" '
+		BEGIN {
+			stations=0; tx_pkts=0; tx_retries=0; tx_failed=0
+			sum_phy=0; phy_count=0
+			sum_sig=0; sig_count=0; min_sig=0
+		}
+		/^Station / { stations++ }
+		/tx packets:/ { tx_pkts += $3+0 }
+		/tx retries:/ { tx_retries += $3+0 }
+		/tx failed:/ { tx_failed += $3+0 }
+		/tx bitrate:/ { sum_phy += $3+0; phy_count++ }
+		/signal avg:/ {
+			for (i = 1; i <= NF; i++) {
+				if ($i ~ /^-[0-9]+$/) {
+					sig = $i+0
+					sum_sig += sig; sig_count++
+					if (sig_count == 1 || sig < min_sig) min_sig = sig
+					break
+				}
+			}
+		}
+		END {
+			avg_phy = (phy_count > 0) ? sum_phy/phy_count : 0
+			# Real per-MPDU Tx PER from mt76 debugfs (passed in) as retry/error %;
+			# raw tx_retries/tx_packets still emitted below but their ratio
+			# over-reads on EHT (per-MPDU vs per-MSDU) so it is not used for health.
+			retry_pct = band_per + 0
+			avg_sig = (sig_count > 0) ? int(sum_sig / sig_count) : 0
+			printf "%d %d %d %d %.1f %d %d %d", \
+				stations, tx_pkts, tx_retries, tx_failed, avg_phy, retry_pct, avg_sig, min_sig
+		}')
+
+		set -- $stats
+		[ -n "$bands_json" ] && bands_json="${bands_json},"
+		local sta_tx_raw
+		case "$band_idx" in
+			0) sta_tx_raw="$sta_tx0" ;;
+			1) sta_tx_raw="$sta_tx1" ;;
+			2) sta_tx_raw="$sta_tx2" ;;
+		esac
+		bands_json="${bands_json}{\"band\":${band_idx},\"stations\":${1:-0},\"tx_packets\":${2:-0},\"tx_retries\":${3:-0},\"tx_failed\":${4:-0},\"avg_phy_rate\":${5:-0},\"retry_pct\":${6:-0},\"avg_signal\":${7:-0},\"min_signal\":${8:-0},\"tx_mbps\":${tx_mbps},\"rx_mbps\":${rx_mbps:-0},\"air_mbps\":${air_mbps:-0},\"hw_tx_mbps\":${hw_tx:-0},\"hw_rx_mbps\":${hw_rx:-0},\"air_eff\":${air_eff:-0},\"frames_ps\":${frames_ps:-0},\"tx_bytes_raw\":${sta_tx_raw:-0}}"
+	done
+
+	printf '{"available":true,"mlo":%s,"bands":[%s]}' "$([ "$is_mld" = 1 ] && echo true || echo false)" "$bands_json"
+}
+
+get_bridge_stats() {
+	# Check br-lan for tx_dropped (CPU can't feed WiFi chip fast enough)
+	# and overall packet rates for bridge activity indication
+
+	local stats
+	stats=$(ip -s link show br-lan 2>/dev/null)
+
+	if [ -z "$stats" ]; then
+		echo '{"available":false}'
+		return
+	fi
+
+	local rx_bytes rx_packets rx_dropped tx_bytes tx_packets tx_dropped
+	rx_bytes=$(echo "$stats"   | awk '/RX:/{getline; print $1+0}')
+	rx_packets=$(echo "$stats" | awk '/RX:/{getline; print $2+0}')
+	rx_dropped=$(echo "$stats" | awk '/RX:/{getline; print $4+0}')
+	tx_bytes=$(echo "$stats"   | awk '/TX:/{getline; print $1+0}')
+	tx_packets=$(echo "$stats" | awk '/TX:/{getline; print $2+0}')
+	tx_dropped=$(echo "$stats" | awk '/TX:/{getline; print $4+0}')
+
+	# Also check for any bridge forwarding errors via brctl if available
+	local fwd_errors=0
+	if command -v brctl > /dev/null 2>&1; then
+		fwd_errors=$(brctl showstp br-lan 2>/dev/null | awk '/forward transitions/{sum+=$NF} END{print sum+0}')
+	fi
+
+	printf '{"available":true,"rx_bytes":%d,"rx_packets":%d,"rx_dropped":%d,"tx_bytes":%d,"tx_packets":%d,"tx_dropped":%d,"fwd_errors":%d}' \
+		"${rx_bytes:-0}" "${rx_packets:-0}" "${rx_dropped:-0}" \
+		"${tx_bytes:-0}" "${tx_packets:-0}" "${tx_dropped:-0}" \
+		"${fwd_errors:-0}"
+}
+
+get_npu_bypass() {
+	# Determines if the NPU is actively offloading traffic.
+	# Primary indicator: offload_bound > 0 (live PPE entries in hardware).
+	# This works in both Router and AP mode — no WAN assumption needed.
+
+	# Check UCI for hw offload setting
+	local hw_offload
+	hw_offload=$(uci get firewall.@defaults[0].flow_offloading_hw 2>/dev/null)
+
+	# Read PPE bound entry count directly from debugfs
+	local offload_bound=0
+	local ppe_bind="/sys/kernel/debug/ppe/bind"
+	if [ -r "$ppe_bind" ]; then
+		offload_bound=$(wc -l < "$ppe_bind" 2>/dev/null || echo 0)
+		# Subtract 1 if file has a header line (starts with non-numeric)
+		local first
+		first=$(head -1 "$ppe_bind" 2>/dev/null)
+		case "$first" in [0-9]*) ;; *) offload_bound=$(( offload_bound - 1 )) ;; esac
+		[ "$offload_bound" -lt 0 ] && offload_bound=0
+	fi
+
+	# CPU % is sampled by npu-jitter-daemon over a steady ~2s background window
+	# and published in the jitter json, so it reflects real system load and is
+	# NOT inflated by this RPC's own per-poll work (the old in-RPC /proc/stat
+	# delta measured its own overhead -> ~15-20% at idle). Read the cached value.
+	local cpu_pct=0
+	if [ -f /tmp/npu-jitter.json ]; then
+		cpu_pct=$(sed -n 's/.*"cpu_pct":\([0-9][0-9]*\).*/\1/p' /tmp/npu-jitter.json)
+		[ -n "$cpu_pct" ] || cpu_pct=0
+	fi
+
+	# Get WAN TX throughput delta (bytes/sec → Mbps) — router mode only
+	local wan_mbps=0
+	local tx_file="/tmp/npu-wan-tx.prev"
+	local wan_dev
+	wan_dev=$(ubus call network.interface.wan status 2>/dev/null | jsonfilter -e "@.l3_device" 2>/dev/null)
+
+	if [ -n "$wan_dev" ]; then
+		local cur_tx
+		cur_tx=$(cat "/sys/class/net/${wan_dev}/statistics/tx_bytes" 2>/dev/null || echo 0)
+		if [ -f "$tx_file" ]; then
+			local prev_tx prev_time cur_time elapsed delta
+			prev_tx=$(awk '{print $1}' "$tx_file" 2>/dev/null || echo 0)
+			prev_time=$(awk '{print $2}' "$tx_file" 2>/dev/null || echo 0)
+			cur_time=$(date +%s)
+			elapsed=$(( cur_time - prev_time ))
+			if [ "$elapsed" -gt 0 ] && [ "$cur_tx" -ge "$prev_tx" ]; then
+				delta=$(( cur_tx - prev_tx ))
+				wan_mbps=$(( delta * 8 / elapsed / 1000000 ))
+			fi
+		fi
+		printf "%s %s" "$cur_tx" "$(date +%s)" > "$tx_file"
+	fi
+
+	# Determine NPU path status using PPE bound entries as ground truth
+	local npu_active="false"
+	local path="cpu"
+	if [ "$hw_offload" = "1" ] && [ "$offload_bound" -gt 0 ]; then
+		npu_active="true"
+		path="npu"
+	elif [ "$hw_offload" = "1" ]; then
+		path="npu_idle"
+	fi
+
+	printf '{"hw_offload_enabled":%s,"cpu_pct":%d,"wan_mbps":%d,"offload_bound":%d,"npu_active":%s,"path":"%s"}' \
+		"$([ "$hw_offload" = "1" ] && echo true || echo false)" \
+		"${cpu_pct:-0}" "${wan_mbps:-0}" "${offload_bound:-0}" "$npu_active" "$path"
+}
+
+get_conflict_alerts() {
+	local alerts=""
+	local alert_count=0
+
+	# ── Alert 1: Ghost Shaper ──────────────────────────────────────────────
+	# NPU HW offload is ON + CAKE is configured on WAN = NPU bypasses CAKE.
+	# Bufferbloat management is inactive for offloaded flows.
+	local hw_offload
+	hw_offload=$(uci get firewall.@defaults[0].flow_offloading_hw 2>/dev/null)
+
+	local cake_on_wan="false"
+	local wan_dev
+	wan_dev=$(ubus call network.interface.wan status 2>/dev/null | jsonfilter -e "@.l3_device" 2>/dev/null)
+	if [ -n "$wan_dev" ] && command -v tc > /dev/null 2>&1; then
+		if tc qdisc show dev "$wan_dev" 2>/dev/null | grep -q "^qdisc cake"; then
+			cake_on_wan="true"
+		fi
+	fi
+
+	if [ "$hw_offload" = "1" ] && [ "$cake_on_wan" = "true" ]; then
+		[ -n "$alerts" ] && alerts="${alerts},"
+		alerts="${alerts}{\"id\":\"ghost_shaper\",\"severity\":\"warning\",\"title\":\"Ghost Shaper Active\",\"message\":\"NPU HW offload is bypassing CAKE SQM. Offloaded flows skip bufferbloat management — latency protection is inactive under load.\"}"
+		alert_count=$((alert_count + 1))
+	fi
+
+	# ── Alert 2: Physical Bottleneck ──────────────────────────────────────
+	# WAN interface has hardware errors — cable/SFP issue, not software bloat.
+	local rx_errors=0
+	if [ -n "$wan_dev" ]; then
+		rx_errors=$(cat "/sys/class/net/${wan_dev}/statistics/rx_errors" 2>/dev/null || echo 0)
+	fi
+
+	if [ "${rx_errors:-0}" -gt 0 ]; then
+		[ -n "$alerts" ] && alerts="${alerts},"
+		alerts="${alerts}{\"id\":\"physical_bottleneck\",\"severity\":\"error\",\"title\":\"Physical Bottleneck\",\"message\":\"Hardware errors detected on WAN (${rx_errors} rx_errors). Check WAN cable or SFP. Latency stats may be misleading.\"}"
+		alert_count=$((alert_count + 1))
+	fi
+
+	# ── Alert 3: NPU Bypass + High Latency ────────────────────────────────
+	# NPU is on but jitter result shows high latency — NPU not helping or
+	# the path has a real latency problem.
+	local jitter_file="/tmp/npu-jitter.json"
+	if [ "$hw_offload" = "1" ] && [ -f "$jitter_file" ]; then
+		local last_ping
+		last_ping=$(jsonfilter -i "$jitter_file" -e "@.last_ping" 2>/dev/null)
+		# Warn if ping > 60ms with hw offload on (something is wrong)
+		if [ -n "$last_ping" ] && awk "BEGIN{exit !($last_ping > 60)}"; then
+			[ -n "$alerts" ] && alerts="${alerts},"
+			alerts="${alerts}{\"id\":\"npu_bypass_latency\",\"severity\":\"warning\",\"title\":\"NPU Bypass Detected\",\"message\":\"HW offload is enabled but ISP latency is high (${last_ping}ms). Latency management may be skipped by hardware acceleration.\"}"
+			alert_count=$((alert_count + 1))
+		fi
+	fi
+
+	printf '{"alert_count":%d,"alerts":[%s]}' "$alert_count" "$alerts"
+}
