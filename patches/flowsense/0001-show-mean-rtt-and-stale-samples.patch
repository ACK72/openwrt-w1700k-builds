From: ACK72
Subject: [PATCH] flowsense: display sampled mean RTT and unavailable states

SPDX-License-Identifier: Apache-2.0

--- a/package/luci-app-airoha-flowsense/htdocs/luci-static/resources/view/airoha_flowsense/status.js
+++ b/package/luci-app-airoha-flowsense/htdocs/luci-static/resources/view/airoha_flowsense/status.js
@@ -693,6 +693,23 @@
 }
 
 /* ── Compass SVG ── */
+// Router-to-target RTT, not the latency of all accelerated flows.
+function latencyState(jitter) {
+	jitter = jitter || {};
+	var average = typeof jitter.avg_ping === 'number' && isFinite(jitter.avg_ping) && jitter.avg_ping >= 0;
+	var age = Date.now() / 1000 - Number(jitter.updated_at || 0);
+	var stale = !jitter.updated_at || age > 3 * (jitter.interval || 5) + 3 || age < -10;
+	var valid = jitter.available === true && average && jitter.samples > 0 && !stale;
+	return {
+		ms: valid ? jitter.avg_ping : 0,
+		label: valid ? jitter.avg_ping.toFixed(1) + 'ms' : (jitter.available === false ? 'N/A' : stale ? 'Stale' : 'No replies'),
+		color: valid ? latencyColor(jitter.avg_ping) : '#888',
+		detail: 'Mean RTT | ' + (jitter.samples || 0) + '/' + (jitter.attempts || 0) +
+			' replies | Loss: ' + (typeof jitter.loss_percent === 'number' ? jitter.loss_percent.toFixed(1) + '%' : 'N/A') +
+			' | ' + (jitter.target || 'No target') + ' | Router-originated probes'
+	};
+}
+
 function compassState(bypass, hwBuf, jitter, wan, wifi, bridge, mode) {
 	bypass = bypass || {}; hwBuf = hwBuf || {}; jitter = jitter || {};
 	wan = wan || {}; wifi = wifi || {}; bridge = bridge || {};
@@ -703,7 +720,8 @@
