+ static void mt76_beacon_mon_iter(void *data, u8 *mac,
+ 				 struct ieee80211_vif *vif)
+ {
+ 	struct mt76_beacon_mon_data *mon = data;
+ 	struct mt76_phy *phy = mon->phy;
++	unsigned long last, now;
+ 	struct mt76_vif_link *mlink = (struct mt76_vif_link *)vif->drv_priv;
+ 	struct mt76_vif_data *mvif = mlink->mvif;
+ 	int link_id;
+ 
+ 	if (vif->type != NL80211_IFTYPE_STATION || !vif->cfg.assoc)
+ 		return;
+ 
+ 	for (link_id = 0; link_id < IEEE80211_MLD_MAX_NUM_LINKS; link_id++) {
+ 		if (link_id == mvif->deflink_id)
+ 			mlink = (struct mt76_vif_link *)vif->drv_priv;
+ 		else
+ 			mlink = rcu_dereference(mvif->link[link_id]);
+ 		if (!mlink || !mlink->beacon_mon_interval)
+ 			continue;
+ 
+ 		if (mt76_vif_link_phy(mlink) != phy)
+ 			continue;
+ 
+ 		if (mon->reset) {
+ 			WRITE_ONCE(mlink->beacon_mon_last, jiffies);
+ 			continue;
+ 		}
+-		if (time_after(jiffies,
+-			       READ_ONCE(mlink->beacon_mon_last) +
++		last = READ_ONCE(mlink->beacon_mon_last);
++		now = jiffies;
++		if (time_after(now,
++			       last +
+ 			       MT76_BEACON_MON_MAX_MISS * mlink->beacon_mon_interval)) {
+ 			dev_warn_ratelimited(phy->dev->dev,
+ 				"beacon loss: band=%u link=%d age=%ums threshold=%ums scan=%d roc=%d tokens=%d\n",
+ 				phy->band_idx, link_id,
+-				jiffies_to_msecs(jiffies - READ_ONCE(mlink->beacon_mon_last)),
++				jiffies_to_msecs(now - last),
+ 				jiffies_to_msecs(MT76_BEACON_MON_MAX_MISS * mlink->beacon_mon_interval),
+ 				test_bit(MT76_SCANNING, &phy->state),
+ 				!!phy->roc_vif, READ_ONCE(phy->dev->token_count));
++			mt76_sta_diag_event(phy->dev, MT76_DIAG_BEACON_LOSS,
++				phy->band_idx, 0, link_id,
++				jiffies_to_msecs(now - last),
++				jiffies_to_msecs(MT76_BEACON_MON_MAX_MISS *
++						 mlink->beacon_mon_interval), 0);
+ 			ieee80211_beacon_loss(vif);
+ 		}
+ 	}
+ }
