+ void mt76_beacon_mon_check(struct mt76_phy *phy)
+ {
+ 	struct mt76_beacon_mon_data mon = { .phy = phy };
+ 
+ 	if (phy->offchannel || test_bit(MT76_RESET, &phy->state) ||
+ 	    test_bit(MT76_MCU_RESET, &phy->dev->phy.state))
+ 		return;
