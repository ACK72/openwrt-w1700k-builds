++			mt76_sta_diag_us(diag_start, diag_locked),
++			mt76_sta_diag_us(diag_locked, ktime_get_ns()), ret);
+ 
+ 	return ret;
+ }
+ EXPORT_SYMBOL_GPL(mt76_mcu_skb_send_and_get_msg);
