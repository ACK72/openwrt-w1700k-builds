+ void mt76_rx_beacon(struct mt76_phy *phy, struct sk_buff *skb)
+ {
+ 	struct mt76_rx_status *status = (struct mt76_rx_status *)skb->cb;
+ 	struct ieee80211_hdr *hdr = mt76_skb_get_hdr(skb);
