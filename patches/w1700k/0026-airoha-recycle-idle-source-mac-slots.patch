+-/* Keep GDM slots reserved even when their ports are not registered.
+- * Do not recycle a slot on flow deletion: a successful SRAM invalidation
+- * does not establish that every in-flight packet has consumed its SMAC.
+- */
+-#define AIROHA_UPDMEM_FIRST 5
+ #define AIROHA_UPDMEM_KEEP 15
+ 
+ static int airoha_ppe_write_upd_mem(struct airoha_eth *eth, u8 slot,
+ 				     const u8 *addr);
+ 
++static bool airoha_ppe_smac_poolable(struct airoha_eth *eth, int slot)
++{
++	int i;
++
++	if (slot < 0 || slot >= AIROHA_UPDMEM_KEEP)
++		return false;
++
++	/* All ports are allocated before any netdev is registered. Keep even
++	 * down ports reserved: ndo_set_mac_address can rewrite their slot.
++	 */
++	for (i = 0; i < ARRAY_SIZE(eth->ports); i++)
++		if (eth->ports[i] && eth->ports[i]->id == slot)
++			return false;
++
++	return true;
++}
++
+ static int airoha_ppe_get_smac_id(struct airoha_eth *eth, const u8 *addr)
+ {
+-	int slot, free = -1, ret;
++	int slot, free = -1, evict = -1, ret;
+ 
+ 	spin_lock_bh(&eth->updmem_lock);
+-	for (slot = AIROHA_UPDMEM_FIRST; slot < AIROHA_UPDMEM_KEEP; slot++) {
++	for (slot = 0; slot < AIROHA_UPDMEM_KEEP; slot++) {
++		if (!airoha_ppe_smac_poolable(eth, slot) ||
++		    (eth->updmem_poisoned & BIT(slot)))
++			continue;
+ 		if ((eth->updmem_valid & BIT(slot)) &&
+ 		    ether_addr_equal(eth->updmem_mac[slot], addr)) {
++			eth->updmem_refcnt[slot]++;
+ 			ret = slot;
+ 			goto unlock;
+ 		}
+-		if (!(eth->updmem_used & BIT(slot)) && free < 0)
+-			free = slot;
+-	}
++		if (!(eth->updmem_used & BIT(slot))) {
++			if (free < 0)
++				free = slot;
++		} else if (!eth->updmem_refcnt[slot] &&
++			   (evict < 0 || eth->updmem_stamp[slot] <
++					 eth->updmem_stamp[evict])) {
++			evict = slot;
++		}
++	}
++	if (free < 0)
++		free = evict;
+ 	ret = -ENOSPC;
+ 	if (free < 0)
+ 		goto unlock;
+ 
+-	/* Quarantine partial writes too: never match or reassign that slot. */
++	/* Retire the cached MAC before either word can be changed. */
+ 	eth->updmem_used |= BIT(free);
++	eth->updmem_valid &= ~BIT(free);
+ 	ret = airoha_ppe_write_upd_mem(eth, free, addr);
+-	if (ret)
++	if (ret) {
++		eth->updmem_poisoned |= BIT(free);
+ 		goto unlock;
++	}
+ 	ether_addr_copy(eth->updmem_mac[free], addr);
+ 	eth->updmem_valid |= BIT(free);
++	eth->updmem_refcnt[free] = 1;
+ 	ret = free;
+ unlock:
+ 	spin_unlock_bh(&eth->updmem_lock);
+ 	return ret;
++}
++
++static void airoha_ppe_put_smac_id(struct airoha_eth *eth,
++				   struct airoha_foe_entry *hwe, bool failed)
++{
++	int slot;
++
++	if (FIELD_GET(AIROHA_FOE_IB1_BIND_PACKET_TYPE, hwe->ib1) <
++	    PPE_PKT_TYPE_IPV6_ROUTE_3T)
++		return;
++
++	slot = FIELD_GET(AIROHA_FOE_MAC_SMAC_ID, hwe->ipv6.l2.src_mac_hi);
++	if (!airoha_ppe_smac_poolable(eth, slot))
++		return;
++
++	spin_lock_bh(&eth->updmem_lock);
++	if (failed)
++		eth->updmem_poisoned |= BIT(slot);
++	if (WARN_ON_ONCE(!eth->updmem_refcnt[slot]))
++		goto unlock;
++	if (!--eth->updmem_refcnt[slot])
++		eth->updmem_stamp[slot] = ++eth->updmem_seq;
++unlock:
++	spin_unlock_bh(&eth->updmem_lock);
+ }
