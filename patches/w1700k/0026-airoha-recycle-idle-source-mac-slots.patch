++	/* Keep the software template bindable. SRAM ACK (or the ordered
++	 * coherent DRAM write) must complete before releasing its MAC.
++	 */
++	invalid = *hwe;
++	invalid.ib1 &= ~AIROHA_FOE_IB1_BIND_STATE;
++	invalid.ib1 |= FIELD_PREP(AIROHA_FOE_IB1_BIND_STATE,
++				 AIROHA_FOE_STATE_INVALID);
++	err = airoha_ppe_foe_commit_entry(ppe, &invalid, e->hash, false);
++	if (err) {
++		e->smac_failed = true;
++		return err;
++	}
++	wmb();
++forget:
++	e->hash = 0xffff;
++	return 0;
++}
