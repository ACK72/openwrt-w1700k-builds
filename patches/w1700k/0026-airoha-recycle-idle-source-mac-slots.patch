++static int airoha_ppe_foe_unbind(struct airoha_ppe *ppe,
++				 struct airoha_flow_table_entry *e)
++{
++	struct airoha_foe_entry *hwe, invalid;
++	int type, err;
++
++	lockdep_assert_held(&ppe_lock);
++	if (e->hash == 0xffff)
++		return 0;
++
++	hwe = airoha_ppe_foe_get_entry_locked(ppe, e->hash);
++	if (!hwe) {
++		e->smac_failed = true;
++		return -ETIMEDOUT;
++	}
++
++	type = FIELD_GET(AIROHA_FOE_IB1_BIND_PACKET_TYPE, e->data.ib1);
++	if (FIELD_GET(AIROHA_FOE_IB1_BIND_STATE, hwe->ib1) !=
++	    AIROHA_FOE_STATE_BIND ||
++	    FIELD_GET(AIROHA_FOE_IB1_BIND_PACKET_TYPE, hwe->ib1) != type ||
++	    !airoha_ppe_foe_compare_entry(e, hwe))
++		goto forget;
++	if (type >= PPE_PKT_TYPE_IPV6_ROUTE_3T &&
++	    ((hwe->ipv6.l2.src_mac_hi ^ e->data.ipv6.l2.src_mac_hi) &
++	     AIROHA_FOE_MAC_SMAC_ID))
++		goto forget;
