+-void mt76_txq_schedule_pending(struct mt76_phy *phy)
++static void
++__mt76_txq_schedule_pending(struct mt76_phy *phy,
++			   struct mt76_tx_pending *pending)
+ {
+ 	LIST_HEAD(tx_list);
+ 	int ret = 0;
+ 
+ 	if (list_empty(&phy->tx_list))
+ 		return;
+ 
+ 	local_bh_disable();
+ 	rcu_read_lock();
+ 
+ 	spin_lock(&phy->tx_lock);
+ 	list_splice_init(&phy->tx_list, &tx_list);
+ 	while (!list_empty(&tx_list)) {
+ 		struct mt76_wcid *wcid;
++		int before = pending ? pending->budget : 0;
+ 
+ 		wcid = list_first_entry(&tx_list, struct mt76_wcid, tx_list);
+ 		list_del_init(&wcid->tx_list);
+ 
+ 		spin_unlock(&phy->tx_lock);
+ 		if (ret >= 0)
+-			ret = mt76_txq_schedule_pending_wcid(phy, wcid, &wcid->tx_offchannel);
++			ret = mt76_txq_schedule_pending_wcid(phy, wcid,
++							  &wcid->tx_offchannel, pending);
+ 		if (ret >= 0 && !phy->offchannel)
+-			ret = mt76_txq_schedule_pending_wcid(phy, wcid, &wcid->tx_pending);
++			ret = mt76_txq_schedule_pending_wcid(phy, wcid,
++							  &wcid->tx_pending, pending);
+ 		spin_lock(&phy->tx_lock);
+ 
+ 		if ((!skb_queue_empty(&wcid->tx_pending) ||
+ 		     !skb_queue_empty(&wcid->tx_offchannel)) &&
+ 		    list_empty(&wcid->tx_list))
+ 			list_add_tail(&wcid->tx_list, &phy->tx_list);
+-	}
++
++		/* A blocked fallback must not undo rotation from the first pass. */
++		if (pending && ret < 0 && pending->budget == before &&
++		    !list_empty(&wcid->tx_list))
++			list_move(&wcid->tx_list, &tx_list);
++
++		if (pending && (!pending->budget || ret < 0))
++			break;
++	}
++	/* Unvisited WCIDs precede the just-serviced WCID on the next pass. */
++	list_splice(&tx_list, &phy->tx_list);
+ 	spin_unlock(&phy->tx_lock);
+ 
+ 	rcu_read_unlock();
+ 	local_bh_enable();
+ }
+ 
++void mt76_txq_schedule_pending(struct mt76_phy *phy)
++{
++	/* Channel changes and legacy callers keep their original drain behavior. */
++	__mt76_txq_schedule_pending(phy, NULL);
++}
++
+ void mt76_txq_schedule_all(struct mt76_phy *phy)
+ {
+ 	struct mt76_phy *main_phy = &phy->dev->phy;
+ 	int i;
+ 
+ 	mt76_txq_schedule_pending(phy);
+ 
+ 	if (phy != main_phy && phy->hw == main_phy->hw)
+ 		return;
+ 
+ 	for (i = 0; i <= MT_TXQ_BK; i++)
+ 		mt76_txq_schedule(phy, i);
+ }
+ EXPORT_SYMBOL_GPL(mt76_txq_schedule_all);
+ 
++static void
++mt76_txq_schedule_shared(struct mt76_dev *dev, struct mt76_phy **phys, int nphy)
++{
++	struct mt76_tx_pending pending[ARRAY_SIZE(dev->phys) + 1];
++	bool reschedule = false;
++	int start, i, j;
++
++	for (i = 0; i < nphy; i++)
++		if (!list_empty(&phys[i]->tx_list))
++			break;
++	if (i == nphy) {
++		for (i = 0; i <= MT_TXQ_BK; i++)
++			mt76_txq_schedule(&dev->phy, i);
++		return;
++	}
++	start = dev->tx_pending_head % nphy;
++
++	/* Snapshot before any dequeue: aliases share one ring budget. Keep at
++	 * least half the available descriptors for the regular data scheduler.
++	 * With only one slot, admission history (not worker invocation count)
++	 * gives pending and regular traffic alternating opportunities.
++	 */
++	for (i = 0; i < nphy; i++) {
++		pending[i].budget = MT_TXQ_FREE_THR;
++		pending[i].reserve = true;
++		pending[i].deferred = false;
++		for (j = 0; j <= MT_TXQ_PSD; j++) {
++			struct mt76_queue *q = phys[i]->q_tx[j];
++			int free;
++
++			if (!q)
++				continue;
++			free = max_t(int, (int)q->ndesc - MT_TXQ_FREE_THR -
++					 READ_ONCE(q->queued), 0);
++			q->tx_pending_budget = min_t(int, MT_TXQ_FREE_THR,
++						    free / 2);
++			if (free == 1 && !q->tx_pending_last)
++				q->tx_pending_budget = 1;
++		}
++	}
++
++	for (i = 0; i < nphy; i++) {
++		j = (start + i) % nphy;
++		__mt76_txq_schedule_pending(phys[j], &pending[j]);
++		if (pending[j].budget != MT_TXQ_FREE_THR)
++			dev->tx_pending_head = (j + 1) % nphy;
++	}
++
++	for (i = 0; i <= MT_TXQ_BK; i++)
++		mt76_txq_schedule(&dev->phy, i);
++
++	/* Do not strand reserved slots when there is no eligible regular data.
++	 * Only revisit lists actually deferred by the ring budget, retaining
++	 * the same per-PHY work budget across both phases.
++	 */
++	for (i = 0; i < nphy; i++) {
++		int before;
++
++		j = (start + i) % nphy;
++		before = pending[j].budget;
++		if (pending[j].deferred && before) {
++			pending[j].reserve = false;
++			__mt76_txq_schedule_pending(phys[j], &pending[j]);
++			if (pending[j].budget != before)
++				dev->tx_pending_head = (j + 1) % nphy;
++		}
++		if (!pending[j].budget && !list_empty(&phys[j]->tx_list))
++			reschedule = true;
++	}
++
++	/* A work budget must not leave frames waiting for a nonexistent future
++	 * completion. Full/blocked/reset queues make no progress and do not
++	 * self-reschedule, so this does not poll a stalled device.
++	 */
++	if (reschedule)
++		mt76_worker_schedule(&dev->tx_worker);
++}
