+ void mt76_tx_worker_run(struct mt76_dev *dev)
+ {
++	struct mt76_phy *shared[ARRAY_SIZE(dev->phys) + 1];
+ 	struct mt76_phy *phy;
+-	int i;
+-
+-	mt76_txq_schedule_all(&dev->phy);
++	int i, nphy = 1;
++
++	shared[0] = &dev->phy;
+ 	for (i = 0; i < ARRAY_SIZE(dev->phys); i++) {
+ 		phy = dev->phys[i];
+-		if (!phy)
++		if (phy && phy != &dev->phy && phy->hw == dev->phy.hw)
++			shared[nphy++] = phy;
++	}
++
++	if (nphy > 1)
++		mt76_txq_schedule_shared(dev, shared, nphy);
++	else
++		mt76_txq_schedule_all(&dev->phy);
++	for (i = 0; i < ARRAY_SIZE(dev->phys); i++) {
++		phy = dev->phys[i];
++		if (!phy || (nphy > 1 && phy->hw == dev->phy.hw))
+ 			continue;
