+ static int
+ mt76_txq_schedule_pending_wcid(struct mt76_phy *phy, struct mt76_wcid *wcid,
+-			       struct sk_buff_head *head)
++			       struct sk_buff_head *head,
++			       struct mt76_tx_pending *pending)
+ {
+ 	struct mt76_dev *dev = phy->dev;
+ 	struct ieee80211_sta *sta;
+ 	struct mt76_queue *q;
+ 	struct sk_buff *skb;
+ 	int ret = 0;
+ 
+ 	spin_lock(&head->lock);
+ 	while ((skb = skb_peek(head)) != NULL) {
+ 		struct ieee80211_hdr *hdr = (struct ieee80211_hdr *)skb->data;
+ 		struct ieee80211_tx_info *info = IEEE80211_SKB_CB(skb);
+ 		int qid = skb_get_queue_mapping(skb);
++
++		if (pending && !pending->budget)
++			break;
+ 
+ 		if ((dev->drv->drv_flags & MT_DRV_HW_MGMT_TXQ) &&
+ 		    !(info->flags & IEEE80211_TX_CTL_HW_80211_ENCAP) &&
+ 		    !ieee80211_is_data_present(hdr->frame_control) &&
+ 		    (!(wcid->tx_info & MT_WCID_TX_INFO_SET) ||
+ 		     !ieee80211_is_bufferable_mmpdu(skb) ||
+ 		     ieee80211_is_deauth(hdr->frame_control) ||
+ 		     ieee80211_is_disassoc(hdr->frame_control) ||
+ 		     head == &wcid->tx_offchannel))
+ 			qid = MT_TXQ_PSD;
+ 
+ 		q = phy->q_tx[qid];
+ 		if (mt76_txq_stopped(q) || test_bit(MT76_RESET, &phy->state)) {
+ 			ret = -1;
+ 			break;
+ 		}
++		if (pending && pending->reserve && !q->tx_pending_budget) {
++			pending->deferred = true;
++			ret = -1;
++			break;
++		}
+ 
+ 		__skb_unlink(skb, head);
+ 		spin_unlock(&head->lock);
++		if (pending) {
++			pending->budget--;
++			if (pending->reserve)
++				q->tx_pending_budget--;
++		}
+ 
+ 		sta = wcid_to_sta(wcid);
+ 		spin_lock(&q->lock);
+-		__mt76_tx_queue_skb(phy, qid, skb, wcid, sta, NULL);
++		if (__mt76_tx_queue_skb(phy, qid, skb, wcid, sta, NULL) >= 0 &&
++		    pending)
++			q->tx_pending_last = true;
+ 		dev->queue_ops->kick(dev, q);
+ 		spin_unlock(&q->lock);
+ 
+ 		spin_lock(&head->lock);
+ 	}
+ 	spin_unlock(&head->lock);
+ 
+ 	return ret;
+ }
