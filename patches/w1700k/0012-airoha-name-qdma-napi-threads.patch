From: ACK72 <ACK72@users.noreply.github.com>
Subject: [PATCH] airoha: expose QDMA identity for locality-aware steering

Assign QDMA/ring names when NAPI threads are created. Linux 6.18 keeps
__set_task_comm internal and procfs prefers the original kthread full
name, so changing task comm after creation cannot provide this identity.

Add a GPL-exported named registration variant and preserve default NAPI
registration. net/core keeps the names for thread recreation in a table
keyed by the NAPI context, not in struct napi_struct, so modules from the
official package feeds keep the official structure layout. Retain RX/TX
poll callbacks, weight and TX busy-poll exclusion. Ring routing, IRQ
ownership and packet scheduling are unchanged.

diff --git a/target/linux/airoha/patches-6.18/9999-airoha-name-qdma-napi-threads.patch b/target/linux/airoha/patches-6.18/9999-airoha-name-qdma-napi-threads.patch
new file mode 100644
--- /dev/null
+++ b/target/linux/airoha/patches-6.18/9999-airoha-name-qdma-napi-threads.patch
@@ -0,0 +1,234 @@
+Subject: [PATCH] net: airoha: assign NAPI thread names at creation
+
+Name the QDMA NAPI threads after their QDMA and ring. net/core keeps the
+names in a table keyed by the NAPI context instead of struct napi_struct, so
+the structure keeps the layout of the official kernel headers that modules
+from the official package feeds are built against. Default registration
+neither reads nor writes NAPI memory beyond that layout.
+
+diff --git a/include/linux/netdevice.h b/include/linux/netdevice.h
+--- a/include/linux/netdevice.h
++++ b/include/linux/netdevice.h
+@@ -2816,6 +2816,33 @@
+  */
+ #define NAPI_POLL_WEIGHT 64
+ 
++void netif_napi_add_weight_named_locked(struct net_device *dev,
++				       struct napi_struct *napi,
++				       int (*poll)(struct napi_struct *, int),
++				       int weight, const char *name);
++
++/**
++ * netif_napi_add_weight_named - register NAPI with a persistent thread name
++ * @dev: network device
++ * @napi: NAPI context
++ * @poll: polling function
++ * @weight: polling weight
++ * @name: optional thread name, copied and truncated to IFNAMSIZ - 1
++ *
++ * Call in process context without the netdev lock held. NULL or an empty
++ * name retains the normal napi/<device>-<id> naming behavior. The name is
++ * kept by the core until the NAPI is deleted, not in struct napi_struct.
++ */
++static inline void
++netif_napi_add_weight_named(struct net_device *dev, struct napi_struct *napi,
++			    int (*poll)(struct napi_struct *, int), int weight,
++			    const char *name)
++{
++	netdev_lock(dev);
++	netif_napi_add_weight_named_locked(dev, napi, poll, weight, name);
++	netdev_unlock(dev);
++}
++
+ void netif_napi_add_weight_locked(struct net_device *dev,
+ 				  struct napi_struct *napi,
+ 				  int (*poll)(struct napi_struct *, int),
+diff --git a/net/core/dev.c b/net/core/dev.c
+--- a/net/core/dev.c
++++ b/net/core/dev.c
+@@ -1632,18 +1632,90 @@
+ }
+ EXPORT_SYMBOL(netdev_notify_peers);
+ 
++/* Optional NAPI thread names stay outside struct napi_struct, so that its
++ * layout matches the official kernel headers that modules from the official
++ * package feeds are built against. Every user runs in process context.
++ */
++struct napi_thread_name {
++	struct hlist_node node;
++	const struct napi_struct *napi;
++	char name[IFNAMSIZ];
++};
++
++static DEFINE_HASHTABLE(napi_thread_names, 6);
++static DEFINE_SPINLOCK(napi_thread_names_lock);
++
++static struct napi_thread_name *
++napi_thread_name_find(const struct napi_struct *napi)
++{
++	struct napi_thread_name *entry;
++
++	hash_for_each_possible(napi_thread_names, entry, node,
++			       (unsigned long)napi)
++		if (entry->napi == napi)
++			return entry;
++
++	return NULL;
++}
++
++/* Record @name for @napi; NULL or an empty name drops a stale entry. */
++static void napi_thread_name_set(const struct napi_struct *napi,
++				 const char *name)
++{
++	struct napi_thread_name *entry, *new = NULL;
++
++	if (name && *name) {
++		/* Without memory the thread keeps its default name. */
++		new = kzalloc(sizeof(*new), GFP_KERNEL);
++		if (new) {
++			new->napi = napi;
++			strscpy(new->name, name, sizeof(new->name));
++		}
++	}
++
++	spin_lock(&napi_thread_names_lock);
++	entry = napi_thread_name_find(napi);
++	if (entry)
++		hash_del(&entry->node);
++	if (new)
++		hash_add(napi_thread_names, &new->node, (unsigned long)napi);
++	spin_unlock(&napi_thread_names_lock);
++	kfree(entry);
++}
++
++static bool napi_thread_name_get(const struct napi_struct *napi,
++				 char name[IFNAMSIZ])
++{
++	struct napi_thread_name *entry;
++	bool found = false;
++
++	spin_lock(&napi_thread_names_lock);
++	entry = napi_thread_name_find(napi);
++	if (entry) {
++		memcpy(name, entry->name, IFNAMSIZ);
++		found = true;
++	}
++	spin_unlock(&napi_thread_names_lock);
++
++	return found;
++}
++
+ static int napi_threaded_poll(void *data);
+ 
+ static int napi_kthread_create(struct napi_struct *n)
+ {
++	char name[IFNAMSIZ];
+ 	int err = 0;
+ 
+ 	/* Create and wake up the kthread once to put it in
+ 	 * TASK_INTERRUPTIBLE mode to avoid the blocked task
+ 	 * warning and work with loadavg.
+ 	 */
+-	n->thread = kthread_run(napi_threaded_poll, n, "napi/%s-%d",
+-				n->dev->name, n->napi_id);
++	if (napi_thread_name_get(n, name))
++		n->thread = kthread_run(napi_threaded_poll, n, "%s", name);
++	else
++		n->thread = kthread_run(napi_threaded_poll, n, "napi/%s-%d",
++					n->dev->name, n->napi_id);
+ 	if (IS_ERR(n->thread)) {
+ 		err = PTR_ERR(n->thread);
+ 		pr_err("kthread_run failed with err %d\n", err);
+@@ -7466,15 +7538,16 @@
+ 	local_bh_enable();
+ }
+ 
+-void netif_napi_add_weight_locked(struct net_device *dev,
+-				  struct napi_struct *napi,
+-				  int (*poll)(struct napi_struct *, int),
+-				  int weight)
++void netif_napi_add_weight_named_locked(struct net_device *dev,
++				       struct napi_struct *napi,
++				       int (*poll)(struct napi_struct *, int),
++				       int weight, const char *name)
+ {
+ 	netdev_assert_locked(dev);
+ 	if (WARN_ON(test_and_set_bit(NAPI_STATE_LISTED, &napi->state)))
+ 		return;
+ 
++	napi_thread_name_set(napi, name);
+ 	INIT_LIST_HEAD(&napi->poll_list);
+ 	INIT_HLIST_NODE(&napi->napi_hash_node);
+ 	hrtimer_setup(&napi->timer, napi_watchdog, CLOCK_MONOTONIC, HRTIMER_MODE_REL_PINNED);
+@@ -7510,6 +7583,15 @@
+ 			dev->threaded = NETDEV_NAPI_THREADED_DISABLED;
+ 	netif_napi_set_irq_locked(napi, -1);
+ }
++EXPORT_SYMBOL_GPL(netif_napi_add_weight_named_locked);
++
++void netif_napi_add_weight_locked(struct net_device *dev,
++				  struct napi_struct *napi,
++				  int (*poll)(struct napi_struct *, int),
++				  int weight)
++{
++	netif_napi_add_weight_named_locked(dev, napi, poll, weight, NULL);
++}
+ EXPORT_SYMBOL(netif_napi_add_weight_locked);
+ 
+ void napi_disable_locked(struct napi_struct *n)
+@@ -7602,6 +7684,8 @@
+ 	if (!test_and_clear_bit(NAPI_STATE_LISTED, &napi->state))
+ 		return;
+ 
++	napi_thread_name_set(napi, NULL);
++
+ 	/* Make sure NAPI is disabled (or was never enabled). */
+ 	WARN_ON(!test_bit(NAPI_STATE_SCHED, &napi->state));
+ 
+diff --git a/drivers/net/ethernet/airoha/airoha_eth.c b/drivers/net/ethernet/airoha/airoha_eth.c
+--- a/drivers/net/ethernet/airoha/airoha_eth.c
++++ b/drivers/net/ethernet/airoha/airoha_eth.c
+@@ -1030,6 +1030,23 @@
+ 	return done;
+ }
+ 
++/* Use real hardware identities instead of the shared dummy netdev name. */
++static void airoha_qdma_add_napi(struct airoha_qdma *qdma,
++				 struct napi_struct *napi,
++				 int (*poll)(struct napi_struct *, int),
++				 char type, int id)
++{
++	char name[IFNAMSIZ];
++	int qdma_id = qdma - qdma->eth->qdma;
++
++	snprintf(name, sizeof(name), "napi/qdma%d-%c%d", qdma_id, type, id);
++	/* Preserve netif_napi_add_tx()'s busy-poll exclusion. */
++	if (type == 't')
++		set_bit(NAPI_STATE_NO_BUSY_POLL, &napi->state);
++	netif_napi_add_weight_named(qdma->eth->napi_dev, napi, poll,
++				    NAPI_POLL_WEIGHT, name);
++}
++
+ static int airoha_qdma_init_rx_queue(struct airoha_queue *q,
+ 				     struct airoha_qdma *qdma, int ndesc)
+ {
+@@ -1072,7 +1089,7 @@
+ 
+ 	q->buf_size = lro_q ? pp_params.max_len : pp_params.max_len / 2;
+ 	q->ndesc = ndesc;
+-	netif_napi_add(eth->napi_dev, &q->napi, airoha_qdma_rx_napi_poll);
++	airoha_qdma_add_napi(qdma, &q->napi, airoha_qdma_rx_napi_poll, 'r', qid);
+ 
+ 	airoha_qdma_wr(qdma, REG_RX_RING_BASE(qid), dma_addr);
+ 	airoha_qdma_rmw(qdma, REG_RX_RING_SIZE(qid),
+@@ -1385,8 +1402,8 @@
+ 	irq_q->size = size;
+ 	irq_q->qdma = qdma;
+ 
+-	netif_napi_add_tx(eth->napi_dev, &irq_q->napi,
+-			  airoha_qdma_tx_napi_poll);
++	airoha_qdma_add_napi(qdma, &irq_q->napi, airoha_qdma_tx_napi_poll,
++			     't', id);
+ 
+ 	airoha_qdma_wr(qdma, REG_TX_IRQ_BASE(id), dma_addr);
+ 	airoha_qdma_rmw(qdma, REG_TX_IRQ_CFG(id), TX_IRQ_DEPTH_MASK,
