From: ACK72 <ACK72@users.noreply.github.com>
Subject: [PATCH] airoha: select Gilly event bounds and Ethernet correctness fixes

diff --git a/package/kernel/mt76/patches/9999-x-mt7996-bound-events.patch b/package/kernel/mt76/patches/9999-x-mt7996-bound-events.patch
new file mode 100644
--- /dev/null
+++ b/package/kernel/mt76/patches/9999-x-mt7996-bound-events.patch
@@ -0,0 +1,22 @@
+From: ACK72 <ACK72@users.noreply.github.com>
+Subject: [PATCH] mt7996: keep AIR_TIME events within the station event bounds
+
+Upstream mt76 now bounds the ALL_STA and countdown events itself
+(56c8b4a4b407 and d17b8d5eff29), replacing the earlier adaptation of
+Gilly 026 and 044. Its ALL_STA element sizes omit the AIR_TIME tag added
+by the station statistics patch, so those events would be discarded.
+Size AIR_TIME entries like the other tags so airtime is still reported.
+Source: Gilly1970/Gemtek-W1700K-6.18 at 0aa0666de1366b69d5d73d98c19809affc1f76ed.
+
+--- a/mt7996/mcu.c
++++ b/mt7996/mcu.c
+@@ -928,6 +928,9 @@ mt7996_mcu_rx_all_sta_info_event(struct
+ 	case UNI_ALL_STA_TXRX_MSDU_COUNT:
+ 		elem_size = sizeof(res->msdu_cnt[0]);
+ 		break;
++	case UNI_ALL_STA_TXRX_AIR_TIME:
++		elem_size = sizeof(res->airtime[0]);
++		break;
+ 	default:
+ 		return;
+ 	}
diff --git a/target/linux/airoha/patches-6.18/999-ack72-ethernet-correctness.patch b/target/linux/airoha/patches-6.18/999-ack72-ethernet-correctness.patch
new file mode 100644
--- /dev/null
+++ b/target/linux/airoha/patches-6.18/999-ack72-ethernet-correctness.patch
@@ -0,0 +1,176 @@
+From: ACK72 <ACK72@users.noreply.github.com>
+Subject: [PATCH] airoha: fix PPE errors, TX BQL teardown and RX IRQ routing
+
+Port Gilly 949, 957 and 980 onto the effective 6.18.52 stack.
+957 is attributed by Gilly <gilroyscott1970@gmail.com> to Lorenzo
+Bianconi; 980 was staged from netdev without a recorded author.
+Source: Gilly1970/Gemtek-W1700K-6.18 at 0aa0666de1366b69d5d73d98c19809affc1f76ed.
+Do not infer a demonstrated UAF merely from the stale skb pointer.
+
+957 completes in-flight BQL bytes when the TX ring is cleaned up. As in
+mainline, ndo_stop must then no longer reset BQL: airoha_qdma_stop() runs
+that cleanup after the reset, and TX NAPI can complete a stopped peer's
+packets on the shared ring later, so either would trip the BUG_ON in
+dql_completed().
+
+--- a/drivers/net/ethernet/airoha/airoha_eth.c
++++ b/drivers/net/ethernet/airoha/airoha_eth.c
+@@ -1015,19 +1015,22 @@
+ 
+ 	if (done < budget && napi_complete(napi)) {
+ 		struct airoha_qdma *qdma = q->qdma;
+ 		int i, qid = q - &qdma->q_rx[0];
+ 		int intr_reg = qid < RX_DONE_HIGH_OFFSET ? QDMA_INT_REG_IDX1
+ 							 : QDMA_INT_REG_IDX2;
++		u32 irq_id = qid % RX_DONE_HIGH_OFFSET;
++		u32 intr_mask = BIT(irq_id) |
++				BIT(irq_id + RX_NO_CPU_DSCP_LOW_OFFSET);
+ 
+ 		for (i = 0; i < ARRAY_SIZE(qdma->irq_banks); i++) {
+ 			if (!(BIT(qid) & RX_IRQ_BANK_PIN_MASK(i)))
+ 				continue;
+ 
+ 			airoha_qdma_irq_enable(&qdma->irq_banks[i], intr_reg,
+-					       BIT(qid % RX_DONE_HIGH_OFFSET));
++					       intr_mask);
+ 		}
+ 	}
+ 
+ 	return done;
+ }
+ 
+@@ -1249,12 +1252,13 @@
+ 		if (!(desc_ctrl & QDMA_DESC_DONE_MASK) &&
+ 		    !(desc_ctrl & QDMA_DESC_DROP_MASK))
+ 			goto unlock;
+ 
+ 		e = &q->entry[index];
+ 		skb = e->skb;
++		e->skb = NULL;
+ 
+ 		dma_unmap_single(eth->dev, e->dma_addr, e->dma_len,
+ 				 DMA_TO_DEVICE);
+ 		e->dma_addr = 0;
+ 		list_add_tail(&e->list, &q->tx_list);
+ 
+@@ -1409,13 +1413,19 @@
+ 
+ 		if (!e->dma_addr)
+ 			continue;
+ 
+ 		dma_unmap_single(eth->dev, e->dma_addr, e->dma_len,
+ 				 DMA_TO_DEVICE);
+-		dev_kfree_skb_any(e->skb);
++		if (e->skb) {
++			struct netdev_queue *txq;
++
++			txq = skb_get_tx_queue(e->skb->dev, e->skb);
++			netdev_tx_completed_queue(txq, 1, e->skb->len);
++			dev_kfree_skb_any(e->skb);
++		}
+ 		e->dma_addr = 0;
+ 		e->skb = NULL;
+ 		list_add_tail(&e->list, &q->tx_list);
+ 
+ 		/* Reset DMA descriptor */
+ 		WRITE_ONCE(desc->ctrl, 0);
+@@ -1665,22 +1675,25 @@
+ 		airoha_qdma_wr(qdma, REG_INT_STATUS(i), intr[i]);
+ 	}
+ 
+ 	if (!test_bit(DEV_STATE_INITIALIZED, &qdma->eth->state))
+ 		return IRQ_NONE;
+ 
+-	rx_intr1 = intr[1] & RX_DONE_LOW_INT_MASK;
++	rx_intr1 = intr[1] & (RX_DONE_LOW_INT_MASK | RX_NO_CPU_DSCP_LOW_INT_MASK);
+ 	if (rx_intr1) {
+ 		airoha_qdma_irq_disable(irq_bank, QDMA_INT_REG_IDX1, rx_intr1);
+-		rx_intr_mask |= rx_intr1;
++		rx_intr_mask |= (rx_intr1 & RX_DONE_LOW_INT_MASK) |
++				RX_NO_CPU_DSCP_INT_RX1_MASK(rx_intr1);
+ 	}
+ 
+-	rx_intr2 = intr[2] & RX_DONE_HIGH_INT_MASK;
++	rx_intr2 = intr[2] & (RX_DONE_HIGH_INT_MASK | RX_NO_CPU_DSCP_HIGH_INT_MASK);
+ 	if (rx_intr2) {
+ 		airoha_qdma_irq_disable(irq_bank, QDMA_INT_REG_IDX2, rx_intr2);
+-		rx_intr_mask |= (rx_intr2 << 16);
++		rx_intr_mask |= ((rx_intr2 & RX_DONE_HIGH_INT_MASK) <<
++				 RX_DONE_HIGH_OFFSET) |
++				(rx_intr2 & RX_NO_CPU_DSCP_HIGH_INT_MASK);
+ 	}
+ 
+ 	for (i = 0; rx_intr_mask && i < ARRAY_SIZE(qdma->q_rx); i++) {
+ 		if (!qdma->q_rx[i].ndesc)
+ 			continue;
+ 
+@@ -2200,18 +2213,19 @@
+ 
+ static int airoha_dev_stop(struct net_device *netdev)
+ {
+ 	struct airoha_gdm_dev *dev = netdev_priv(netdev);
+ 	struct airoha_gdm_port *port = dev->port;
+ 	struct airoha_qdma *qdma;
+-	int i;
+ 
++	/* Do not reset BQL here: in-flight packets on the shared QDMA ring are
++	 * completed later by TX NAPI or by airoha_qdma_cleanup_tx_queue(), and
++	 * completing them against a reset queue would trip dql_completed().
++	 */
+ 	netif_tx_disable(netdev);
+ 	airoha_set_vip_for_gdm_port(dev, false);
+-	for (i = 0; i < netdev->num_tx_queues; i++)
+-		netdev_tx_reset_subqueue(netdev, i);
+ 
+ 	qdma = airoha_qdma_deref(dev);
+ 	if (--port->users)
+ 		airoha_ppe_set_mtu(dev);
+ 	else
+ 		airoha_set_gdm_port_fwd_cfg(qdma->eth,
+--- a/drivers/net/ethernet/airoha/airoha_ppe.c
++++ b/drivers/net/ethernet/airoha/airoha_ppe.c
+@@ -1468,24 +1468,24 @@
+ }
+ 
+ static int airoha_ppe_flush_sram_entries(struct airoha_ppe *ppe)
+ {
+ 	u32 sram_num_entries = airoha_ppe_get_total_sram_num_entries(ppe);
+ 	struct airoha_foe_entry *hwe = ppe->foe;
+-	int i, err = 0;
++	int i;
+ 
+ 	for (i = 0; i < sram_num_entries; i++) {
+ 		int err;
+ 
+ 		memset(&hwe[i], 0, sizeof(*hwe));
+ 		err = airoha_ppe_foe_commit_sram_entry(ppe, i);
+ 		if (err)
+-			break;
++			return err;
+ 	}
+ 
+-	return err;
++	return 0;
+ }
+ 
+ static struct airoha_npu *airoha_ppe_npu_get(struct airoha_eth *eth)
+ {
+ 	struct airoha_npu *npu = airoha_npu_get(eth->dev);
+ 
+--- a/drivers/net/ethernet/airoha/airoha_regs.h
++++ b/drivers/net/ethernet/airoha/airoha_regs.h
+@@ -572,12 +572,14 @@
+ 	 RX1_DONE_INT_MASK | RX0_DONE_INT_MASK)
+ 
+ #define RX_NO_CPU_DSCP_LOW_OFFSET	__ffs(RX_NO_CPU_DSCP_LOW_INT_MASK)
+ #define INT_RX1_MASK(_n)							\
+ 	((((_n) << RX_NO_CPU_DSCP_LOW_OFFSET) & RX_NO_CPU_DSCP_LOW_INT_MASK) |	\
+ 	 (RX_DONE_LOW_INT_MASK & (_n)))
++#define RX_NO_CPU_DSCP_INT_RX1_MASK(_n)					\
++	(((_n) & RX_NO_CPU_DSCP_LOW_INT_MASK) >> RX_NO_CPU_DSCP_LOW_OFFSET)
+ 
+ /* QDMA_CSR_INT_ENABLE3 */
+ #define RX31_NO_CPU_DSCP_INT_MASK	BIT(31)
+ #define RX30_NO_CPU_DSCP_INT_MASK	BIT(30)
+ #define RX29_NO_CPU_DSCP_INT_MASK	BIT(29)
+ #define RX28_NO_CPU_DSCP_INT_MASK	BIT(28)
