+--- a/drivers/net/ethernet/airoha/airoha_eth.c
++++ b/drivers/net/ethernet/airoha/airoha_eth.c
+@@ -745,13 +745,13 @@
+ 	struct sk_buff *skb;
+ 	struct tcphdr *th;
+ 	struct page *page;
+ 	bool ipv4, ipv6;
+ 
+ 	agg_count = FIELD_GET(QDMA_ETH_RXMSG_AGG_COUNT_MASK, msg2);
+-	if (agg_count > AIROHA_RXQ_LRO_MAX_AGG_COUNT)
++	if (!agg_count || agg_count > AIROHA_RXQ_LRO_MAX_AGG_COUNT)
+ 		return NULL;
+ 
+ 	ipv4 = FIELD_GET(QDMA_ETH_RXMSG_IP4_MASK, msg1);
+ 	ipv6 = FIELD_GET(QDMA_ETH_RXMSG_IP6_MASK, msg1);
+ 	if (!ipv4 && !ipv6)
+ 		return NULL;
+@@ -798,13 +798,13 @@
+ 
+ 	th = (struct tcphdr *)(e->buf + th_off);
+ 	if (th->doff < 5)
+ 		return NULL;
+ 
+ 	data_off = th_off + (th->doff << 2);
+-	if (len < data_off)
++	if (len <= data_off)
+ 		return NULL;
+ 
+ 	tcp_win = FIELD_GET(QDMA_ETH_RXMSG_TCP_WIN_MASK, msg3);
+ 	tcp_ack_seq = le32_to_cpu(READ_ONCE(desc->data));
+ 	th->ack_seq = cpu_to_be32(tcp_ack_seq);
+ 	th->window = cpu_to_be16(tcp_win);
+@@ -2128,12 +2128,13 @@
+ {
+ 	u32 status;
+ 
+ 	if (--qdma->users)
+ 		return;
+ 
++	airoha_fe_lro_disable(qdma->eth, qdma - &qdma->eth->qdma[0]);
+ 	airoha_qdma_clear(qdma, REG_QDMA_GLOBAL_CFG,
+ 			  GLOBAL_CFG_TX_DMA_EN_MASK |
+ 			  GLOBAL_CFG_RX_DMA_EN_MASK);
+ 
+ 	if (read_poll_timeout(airoha_qdma_rr, status,
+ 			      !(status & (GLOBAL_CFG_TX_DMA_BUSY_MASK |
