+--- a/drivers/net/pcs/airoha/pcs-airoha-common.c
++++ b/drivers/net/pcs/airoha/pcs-airoha-common.c
+@@ -881,6 +881,24 @@ static void airoha_pcs_link_up(struct phylink_pcs *pcs, unsigned int neg_mode,
+ 	if (data->link_up)
+ 		data->link_up(priv, port->index);
+ 
++	/* TEST VALUE, not a general fix. This patch's description lists what a
++	 * fix for every port and speed still needs.
++	 *
++	 * With TX_FRAG_LEN at its maximum, 31, which means fragmentation off,
++	 * the MAC keeps starting frames for about 20 us after it receives XOFF:
++	 * two or three frames at 1 Gbps. A link partner that polices with PAUSE
++	 * drops what exceeds its headroom. With 4 the MAC usually finishes the
++	 * current frame and stops. 4 is empirical: the field's unit is not
++	 * documented, and 30 stalled TX, so other values are not interchangeable.
++	 *
++	 * TX is stopped here until the enable below.
++	 */
++	if (priv->limit_tx_frag)
++		regmap_update_bits(maps->pcs_mac, AIROHA_PCS_XFI_MAC_XFI_GIB_CFG,
++				   AIROHA_PCS_XFI_TX_FRAG_LEN,
++				   FIELD_PREP(AIROHA_PCS_XFI_TX_FRAG_LEN,
++					      speed <= SPEED_1000 ? 4 : 31));
++
+ 	/* BPI BMI enable */
+ 	regmap_clear_bits(maps->pcs_mac, AIROHA_PCS_XFI_MAC_XFI_GIB_CFG,
+ 			  AIROHA_PCS_XFI_RXMPI_STOP |
+@@ -1331,6 +1349,20 @@ static int airoha_pcs_probe(struct platform_device *pdev)
+ 			priv->manual_rx_calib = true;
+ 	}
+ 
++	/* Limited to the measured port and revisions: the vendor SDK keeps TX
++	 * fragmentation off before E2, where it conflicts with flow control.
++	 */
++	if (device_is_compatible(dev, "airoha,an7581-pcs-pon")) {
++		u32 val;
++
++		ret = regmap_read(priv->scu, AIROHA_SCU_PDIDR, &val);
++		if (ret)
++			return ret;
++
++		if (FIELD_GET(AIROHA_SCU_PRODUCT_ID, val) >= 0x2)
++			priv->limit_tx_frag = true;
++	}
++
+ 	for (index = 0; index < data->num_port; index++) {
+ 		struct airoha_pcs_port *port = &priv->ports[index];
+ 
+--- a/drivers/net/pcs/airoha/pcs-airoha.h
++++ b/drivers/net/pcs/airoha/pcs-airoha.h
+@@ -1660,6 +1660,7 @@ struct airoha_pcs_priv {
+ 	struct phy *phy;
+ 
+ 	bool manual_rx_calib;
++	bool limit_tx_frag;
+ };
