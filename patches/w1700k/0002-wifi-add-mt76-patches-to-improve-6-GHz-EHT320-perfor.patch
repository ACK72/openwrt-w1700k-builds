diff --git a/package/kernel/mt76/patches/9990-wifi-mt76-mt7996-advertise-eht-to-firmware-rate-control.patch b/package/kernel/mt76/patches/9990-wifi-mt76-mt7996-advertise-eht-to-firmware-rate-control.patch
