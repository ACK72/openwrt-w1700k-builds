From: ACK72 <acikom72@gmail.com>
Date: Mon, 28 Sep 2026 22:32:48 +0900
Subject: [PATCH] airoha: reduce guarded L2, mailbox and initialization overhead

Resolve ingress metadata only for L2 fallback; retain the collision
window and checked flow removal. Omit unused WLAN SET reply copies. Sleep
between sleepable initialization retries while retaining the minimum wait
and retry limit. Atomic PPE mailbox locking and timeout behavior are
unchanged. The TRTCM readback change this patch carried before is upstream
as airoha 187 ("net: airoha: Add retry mechanism to
airoha_qdma_set_trtcm_param()").

diff --git a/target/linux/airoha/patches-6.18/9999-zzzzzzzz-0018-airoha-reduce-guarded-control-path-overhead.patch b/target/linux/airoha/patches-6.18/9999-zzzzzzzz-0018-airoha-reduce-guarded-control-path-overhead.patch
new file mode 100644
--- /dev/null
+++ b/target/linux/airoha/patches-6.18/9999-zzzzzzzz-0018-airoha-reduce-guarded-control-path-overhead.patch
@@ -0,0 +1,97 @@
+From: ACK72 <acikom72@gmail.com>
+Date: Mon, 28 Sep 2026 22:32:48 +0900
+Subject: [PATCH] airoha: reduce guarded L2, mailbox and initialization overhead
+
+Resolve ingress metadata only for L2 fallback; retain the collision
+window and checked flow removal. Omit unused WLAN SET reply copies. Sleep
+between sleepable initialization retries while retaining the minimum wait
+and retry limit. Atomic PPE mailbox locking and timeout behavior are
+unchanged. The TRTCM readback change this patch carried before is upstream
+as airoha 187 ("net: airoha: Add retry mechanism to
+airoha_qdma_set_trtcm_param()").
+
+--- a/drivers/net/ethernet/airoha/airoha_ppe.c
++++ b/drivers/net/ethernet/airoha/airoha_ppe.c
+@@ -1112,17 +1112,17 @@
+ static void airoha_ppe_foe_insert_entry(struct airoha_ppe *ppe,
+ 					struct sk_buff *skb,
+ 					u32 hash, bool rx_wlan)
+ {
+ 	struct airoha_flow_table_entry *e;
+ 	struct airoha_foe_bridge br = {};
+ 	struct airoha_foe_entry *hwe;
+ 	struct hlist_node *n;
+-	u32 index, state, ingress = airoha_ppe_foe_ingress(skb);
++	u32 index, state;
+ 
+ 	spin_lock_bh(&ppe_lock);
+ 
+ 	hwe = airoha_ppe_foe_get_entry_locked(ppe, hash);
+ 	if (!hwe)
+ 		goto unlock;
+ 
+ 	state = FIELD_GET(AIROHA_FOE_IB1_BIND_STATE, hwe->ib1);
+@@ -1153,17 +1153,17 @@
+ 		if (airoha_ppe_foe_commit_entry(ppe, &e->data, hash, rx_wlan))
+ 			e->smac_failed = true;
+ 		goto unlock;
+ 	}
+ 
+ 	airoha_ppe_foe_set_bridge_addrs(&br, eth_hdr(skb));
+ 	e = rhashtable_lookup_fast(&ppe->l2_flows, &br,
+ 				   airoha_l2_flow_table_params);
+-	if (e && !airoha_ppe_foe_l2_claim(ppe, e, ingress))
++	if (e && !airoha_ppe_foe_l2_claim(ppe, e, airoha_ppe_foe_ingress(skb)))
+ 		airoha_ppe_foe_commit_subflow_entry(ppe, e, hash, rx_wlan);
+ unlock:
+ 	spin_unlock_bh(&ppe_lock);
+ }
+ 
+ static int
+ airoha_ppe_foe_l2_flow_commit_entry(struct airoha_ppe *ppe,
+ 				    struct airoha_flow_table_entry *e)
+--- a/drivers/net/ethernet/airoha/airoha_npu.c
++++ b/drivers/net/ethernet/airoha/airoha_npu.c
+@@ -497,17 +497,18 @@
+ 	if (!wlan_data)
+ 		return -ENOMEM;
+ 
+ 	wlan_data->ifindex = ifindex;
+ 	wlan_data->func_type = NPU_OP_SET;
+ 	wlan_data->func_id = func_id;
+ 	memcpy(wlan_data->d, data, data_len);
+ 
+-	err = airoha_npu_send_msg(npu, NPU_FUNC_WIFI, wlan_data, len);
++	/* SET callers discard the payload; retain mailbox status/ACK checks. */
++	err = __airoha_npu_send_msg(npu, NPU_FUNC_WIFI, wlan_data, len, NULL, 0);
+ 	kfree(wlan_data);
+ 
+ 	return err;
+ }
+ 
+ static int airoha_npu_wlan_msg_get(struct airoha_npu *npu, int ifindex,
+ 				   enum airoha_npu_wlan_get_cmd func_id,
+ 				   void *data, int data_len, gfp_t gfp)
+@@ -563,20 +564,20 @@
+ 			err = airoha_npu_wlan_msg_send(npu, ifindex, cmd, val,
+ 						       sizeof(*val),
+ 						       GFP_KERNEL);
+ 		else
+ 			err = airoha_npu_wlan_set_reserved_memory(npu, ifindex,
+ 								  name, cmd);
+ 		if (!err)
+ 			break;
+-		mdelay(10);
++		usleep_range(10000, 11000);
+ 		retry_cnt--;
+ 	}
+-	mdelay(10);
++	usleep_range(10000, 11000);
+ 	if (!retry_cnt)
+ 		return err;
+ 	return 0;
+ }
+ 
+ static int airoha_npu_wlan_init_memory(struct airoha_npu *npu)
+ {
+ 	enum airoha_npu_wlan_set_cmd cmd = WLAN_FUNC_SET_WAIT_NPU_BAND0_ONCPU;
