From 4573e44beb66a25a5031c7f83eb170056f339357 Mon Sep 17 00:00:00 2001
From: ACK72 <acikom72@gmail.com>
Date: Wed, 30 Sep 2026 02:38:52 +0900
Subject: [PATCH] build: extract git archives with the umask as root

DownloadMethod/rawgit packs a git source by extracting git archive output
and archiving the result again, recording the extracted file modes. git
archive stores 0664 files and 0775 directories. An unprivileged tar applies
the umask while extracting, but root keeps the stored modes, so a root build
packs a tarball that differs from PKG_MIRROR_HASH whenever the source mirror
does not carry it yet.

Pass --no-same-permissions, as scripts/dl_github_archive.py already does.
Unprivileged builds are unaffected; TAR_OPTIONS cannot be used because
toplevel.mk unexports it.

Reproduced for ubus 414c60a2: unprivileged packing gives the published
45685cbf..., root packing gives b3022db0.... The method reproduces the
mirror's ubus 24864e78 tarball byte for byte.
---
 include/download.mk | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/include/download.mk b/include/download.mk
index 0ea08d372c7..b9913634e02 100644
--- a/include/download.mk
+++ b/include/download.mk
@@ -251,7 +251,7 @@ define DownloadMethod/rawgit
 		$(TAR) --numeric-owner --owner=0 --group=0 --ignore-failed-read -C $(SUBDIR) -f $(SUBDIR).tar.git -r .git .gitmodules 2>/dev/null \
 	) && \
 	rm -rf $(SUBDIR) && mkdir $(SUBDIR) && \
-	$(TAR) -C $(SUBDIR) -xf $(SUBDIR).tar.git && \
+	$(TAR) -C $(SUBDIR) --no-same-permissions -xf $(SUBDIR).tar.git && \
 	(cd $(SUBDIR) && $(if $(filter skip,$(SUBMODULES)),true,git submodule update --init --recursive -- $(SUBMODULES) && \
 	rm -rf .git .gitmodules)) && \
 	echo "Packing checkout..." && \
