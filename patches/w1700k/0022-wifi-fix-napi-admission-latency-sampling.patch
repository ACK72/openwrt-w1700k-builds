From: ACK72 <ACK72@users.noreply.github.com>
Subject: [PATCH] wifi: avoid false NAPI admission latency samples

A disabled or already scheduled NAPI can reject a scheduling request.
Recording that request unconditionally can leave a stale timestamp for
a later poll. Acquire scheduling ownership before recording and enqueue
only afterward so a threaded poll cannot outrun the timestamp.

Keep napi_schedule_prep() handling of DISABLE/MISSED and __napi_schedule()
dispatch, including PREEMPT_RT behavior. A fresh admission replaces any
timestamp left by a previously disabled scheduling instance. Queue names,
CPU placement, IRQ masking, polling budgets and reset behavior are unchanged.

diff --git a/package/kernel/mt76/Makefile b/package/kernel/mt76/Makefile
--- a/package/kernel/mt76/Makefile
+++ b/package/kernel/mt76/Makefile
@@ -1,7 +1,7 @@
 include $(TOPDIR)/rules.mk
 
 PKG_NAME:=mt76
-PKG_RELEASE=13
+PKG_RELEASE=14
 
 PKG_LICENSE:=BSD-3-Clause-Clear
 PKG_LICENSE_FILES:=
diff --git a/package/kernel/mt76/patches/9999-zzzzz-mt76-diag-napi-admission.patch b/package/kernel/mt76/patches/9999-zzzzz-mt76-diag-napi-admission.patch
new file mode 100644
--- /dev/null
+++ b/package/kernel/mt76/patches/9999-zzzzz-mt76-diag-napi-admission.patch
@@ -0,0 +1,288 @@
+From: ACK72 <ACK72@users.noreply.github.com>
+Subject: [PATCH] mt76: timestamp only accepted NAPI scheduling requests
+
+--- a/mt76.h
++++ b/mt76.h
+@@ -1041,50 +1041,64 @@
+ 		struct mt76_vif_link *mlink;
+ 		struct mt76_phy *phy;
+ 		int chan_idx;
+ 		bool beacon_wait;
+ 		bool beacon_received;
+ 	} scan;
+ 
+ #ifdef CONFIG_NL80211_TESTMODE
+ 	const struct mt76_testmode_ops *test_ops;
+ 	struct {
+ 		const char *name;
+ 		u32 offset;
+ 	} test_mtd;
+ #endif
+ 	struct workqueue_struct *wq;
+ 
+ 	union {
+ 		struct mt76_mmio mmio;
+ 		struct mt76_usb usb;
+ 		struct mt76_sdio sdio;
+ 	};
+ 
+ 	atomic_t bus_hung;
+ 	struct mt76_sta_diag sta_diag;
+ };
++
++/* Match napi_schedule(): record only after acquiring scheduling ownership.
++ * Recording after __napi_schedule() would race a threaded poll on another CPU.
++ */
++static inline bool mt76_napi_schedule(struct mt76_dev *dev, int qid)
++{
++	struct napi_struct *napi = &dev->napi[qid];
++
++	if (!napi_schedule_prep(napi))
++		return false;
++	mt76_sta_diag_schedule(dev, qid);
++	__napi_schedule(napi);
++	return true;
++}
+ 
+ static inline u64 mt76_sta_diag_clock(struct mt76_dev *dev)
+ {
+ 	return unlikely(READ_ONCE(dev->sta_diag.enabled)) ? ktime_get_ns() : 0;
+ }
+ 
+ static inline u32 mt76_sta_diag_us(u64 start, u64 end)
+ {
+ 	if (!start || end < start)
+ 		return 0;
+ 	return min_t(u64, div_u64(end - start, NSEC_PER_USEC), U32_MAX);
+ }
+ 
+ /* per-phy stats.  */
+ struct mt76_mib_stats {
+ 	u32 ack_fail_cnt;
+ 	u32 fcs_err_cnt;
+ 	u32 rts_cnt;
+ 	u32 rts_retries_cnt;
+ 	u32 ba_miss_cnt;
+ 	u32 tx_bf_cnt;
+ 	u32 tx_mu_bf_cnt;
+ 	u32 tx_mu_mpdu_cnt;
+ 	u32 tx_mu_acked_mpdu_cnt;
+ 	u32 tx_su_acked_mpdu_cnt;
+--- a/sta_diag.c
++++ b/sta_diag.c
+@@ -18,51 +18,52 @@
+ void mt76_sta_diag_event(struct mt76_dev *dev, u16 event, int band,
+ 			u64 start, u32 a, u32 b, u32 c, int result)
+ {
+ 	struct mt76_sta_diag *diag = &dev->sta_diag;
+ 	unsigned long flags;
+ 
+ 	if (!READ_ONCE(diag->enabled))
+ 		return;
+ 
+ 	spin_lock_irqsave(&diag->lock, flags);
+ 	if (diag->enabled && (!start || start >= diag->data.since_ns))
+ 		mt76_sta_diag_store(&diag->data, ktime_get_ns(), event, band,
+ 				    a, b, c, result);
+ 	spin_unlock_irqrestore(&diag->lock, flags);
+ }
+ EXPORT_SYMBOL_GPL(mt76_sta_diag_event);
+ 
+ void mt76_sta_diag_schedule(struct mt76_dev *dev, int qid)
+ {
+ 	struct mt76_sta_diag *diag = &dev->sta_diag;
+ 	unsigned long flags;
+ 
+ 	if (!READ_ONCE(diag->enabled))
+ 		return;
+ 	spin_lock_irqsave(&diag->lock, flags);
+-	if (diag->enabled && !diag->data.queued_ns[qid])
++	/* A fresh successful admission supersedes any pre-disable timestamp. */
++	if (diag->enabled)
+ 		diag->data.queued_ns[qid] = ktime_get_ns();
+ 	spin_unlock_irqrestore(&diag->lock, flags);
+ }
+ EXPORT_SYMBOL_GPL(mt76_sta_diag_schedule);
+ 
+ u64 mt76_sta_diag_poll_begin(struct mt76_dev *dev, int qid)
+ {
+ 	struct mt76_sta_diag *diag = &dev->sta_diag;
+ 	struct mt76_sta_diag_data *data = &diag->data;
+ 	unsigned long flags;
+ 	u64 now = 0;
+ 	u32 wait;
+ 
+ 	if (!READ_ONCE(diag->enabled))
+ 		return 0;
+ 	spin_lock_irqsave(&diag->lock, flags);
+ 	if (!diag->enabled)
+ 		goto out;
+ 	now = ktime_get_ns();
+ 	wait = mt76_sta_diag_us(data->queued_ns[qid], now);
+ 	data->queued_ns[qid] = 0;
+ 	data->polls[qid]++;
+ 	data->wait_max_us[qid] = max(data->wait_max_us[qid], wait);
+ 	if (wait >= MT76_STA_DIAG_SLOW_US)
+ 		mt76_sta_diag_store(data, now, MT76_DIAG_NAPI_WAIT, -1,
+--- a/npu.c
++++ b/npu.c
+@@ -231,52 +231,51 @@
+ 
+ 	rcu_read_unlock();
+ 
+ 	return done;
+ }
+ 
+ static irqreturn_t mt76_npu_irq_handler(int irq, void *q_instance)
+ {
+ 	struct mt76_queue *q = q_instance;
+ 	struct mt76_dev *dev = q->dev;
+ 	int qid = q - &dev->q_rx[0];
+ 	int index = qid - MT_RXQ_NPU0;
+ 	struct airoha_npu *npu;
+ 	u32 status;
+ 
+ 	rcu_read_lock();
+ 
+ 	npu = rcu_dereference(dev->mmio.npu);
+ 	if (!npu)
+ 		goto out;
+ 
+ 	status = airoha_npu_wlan_get_irq_status(npu, index);
+ 	airoha_npu_wlan_set_irq_status(npu, status);
+ 
+ 	airoha_npu_wlan_disable_irq(npu, index);
+-	mt76_sta_diag_schedule(dev, qid);
+-	napi_schedule(&dev->napi[qid]);
++	mt76_napi_schedule(dev, qid);
+ out:
+ 	rcu_read_unlock();
+ 
+ 	return IRQ_HANDLED;
+ }
+ 
+ int mt76_npu_dma_add_buf(struct mt76_phy *phy, struct mt76_queue *q,
+ 			 struct sk_buff *skb, struct mt76_queue_buf *buf,
+ 			 void *txwi_ptr)
+ {
+ 	u16 txwi_len = min_t(u16, phy->dev->drv->txwi_size, NPU_TXWI_LEN);
+ 	struct airoha_npu_tx_dma_desc *desc = (void *)q->desc;
+ 	int ret;
+ 
+ 	/* TODO: Take into account unlinear skbs */
+ 	memcpy(desc[q->head].txwi, txwi_ptr, txwi_len);
+ 	desc[q->head].addr = buf->addr;
+ 	desc[q->head].ctrl = FIELD_PREP(NPU_TX_DMA_DESC_VEND_LEN_MASK, txwi_len) |
+ 			     FIELD_PREP(NPU_TX_DMA_DESC_LEN_MASK, skb->len) |
+ 			     NPU_TX_DMA_DESC_DONE_MASK;
+ 
+ 	ret = q->head;
+ 	q->entry[q->head].skip_buf0 = true;
+ 	q->entry[q->head].skip_buf1 = true;
+ 	q->entry[q->head].txwi = NULL;
+--- a/mt7996/mmio.c
++++ b/mt7996/mmio.c
+@@ -748,99 +748,95 @@
+ 			airoha_npu_wlan_enable_irq(npu, q - MT_RXQ_NPU0);
+ 	} else {
+ 		struct mt7996_dev *dev = container_of(mdev, struct mt7996_dev,
+ 						      mt76);
+ 
+ 		mt7996_irq_enable(dev, MT_INT_RX(q));
+ 	}
+ }
+ 
+ /* TODO: support 2/4/6/8 MSI-X vectors */
+ static void mt7996_irq_tasklet(struct tasklet_struct *t)
+ {
+ 	struct mt7996_dev *dev = from_tasklet(dev, t, mt76.irq_tasklet);
+ 	struct mtk_wed_device *wed = &dev->mt76.mmio.wed;
+ 	struct mtk_wed_device *wed_hif2 = &dev->mt76.mmio.wed_hif2;
+ 	u32 i, intr, mask, intr1 = 0;
+ 
+ 	if (READ_ONCE(dev->recovery.failed))
+ 		return;
+ 
+ 	if (dev->hif2 && mtk_wed_device_active(wed_hif2)) {
+ 		mtk_wed_device_irq_set_mask(wed_hif2, 0);
+ 		intr1 = mtk_wed_device_irq_get(wed_hif2,
+ 					       dev->mt76.mmio.irqmask);
+ 		if (intr1 & MT_INT_RX_TXFREE_EXT) {
+-			mt76_sta_diag_schedule(&dev->mt76, MT_RXQ_TXFREE_BAND2);
+-			napi_schedule(&dev->mt76.napi[MT_RXQ_TXFREE_BAND2]);
++			mt76_napi_schedule(&dev->mt76, MT_RXQ_TXFREE_BAND2);
+ 		}
+ 
+ 		if (intr1 & MT_INT_RX_DONE_BAND2_EXT) {
+-			mt76_sta_diag_schedule(&dev->mt76, MT_RXQ_BAND2);
+-			napi_schedule(&dev->mt76.napi[MT_RXQ_BAND2]);
++			mt76_napi_schedule(&dev->mt76, MT_RXQ_BAND2);
+ 		}
+ 
+ 		if (intr1 & MT_INT_RX_TXFREE_BAND1_EXT) {
+-			mt76_sta_diag_schedule(&dev->mt76, MT_RXQ_BAND1_WA);
+-			napi_schedule(&dev->mt76.napi[MT_RXQ_BAND1_WA]);
++			mt76_napi_schedule(&dev->mt76, MT_RXQ_BAND1_WA);
+ 		}
+ 	}
+ 
+ 	if (mtk_wed_device_active(wed)) {
+ 		mtk_wed_device_irq_set_mask(wed, 0);
+ 		intr = mtk_wed_device_irq_get(wed, dev->mt76.mmio.irqmask);
+ 		intr |= (intr1 & ~MT_INT_TX_RX_DONE_EXT);
+ 	} else {
+ 		mt76_wr(dev, MT_INT_MASK_CSR, 0);
+ 		if (dev->hif2)
+ 			mt76_wr(dev, MT_INT1_MASK_CSR, 0);
+ 
+ 		intr = mt76_rr(dev, MT_INT_SOURCE_CSR);
+ 		intr &= dev->mt76.mmio.irqmask;
+ 		mt76_wr(dev, MT_INT_SOURCE_CSR, intr);
+ 		if (dev->hif2) {
+ 			intr1 = mt76_rr(dev, MT_INT1_SOURCE_CSR);
+ 			intr1 &= dev->mt76.mmio.irqmask;
+ 			mt76_wr(dev, MT_INT1_SOURCE_CSR, intr1);
+ 			intr |= intr1;
+ 		}
+ 	}
+ 
+ 	trace_dev_irq(&dev->mt76, intr, dev->mt76.mmio.irqmask);
+ 
+ 	mask = intr & MT_INT_RX_DONE_ALL;
+ 	if (intr & MT_INT_TX_DONE_MCU)
+ 		mask |= MT_INT_TX_DONE_MCU;
+ 	mt7996_irq_disable(dev, mask);
+ 
+ 	if (intr & MT_INT_TX_DONE_MCU)
+ 		napi_schedule(&dev->mt76.tx_napi);
+ 
+ 	for (i = 0; i < __MT_RXQ_MAX; i++) {
+ 		if ((intr & MT_INT_RX(i))) {
+-			mt76_sta_diag_schedule(&dev->mt76, i);
+-			napi_schedule(&dev->mt76.napi[i]);
++			mt76_napi_schedule(&dev->mt76, i);
+ 		}
+ 	}
+ 
+ 	if (intr & MT_INT_MCU_CMD) {
+ 		u32 val = mt76_rr(dev, MT_MCU_CMD);
+ 
+ 		mt76_wr(dev, MT_MCU_CMD, val);
+ 		if (val & (MT_MCU_CMD_ERROR_MASK | MT_MCU_CMD_WDT_MASK)) {
+ 			dev->recovery.state = val;
+ 			mt7996_reset(dev);
+ 		}
+ 	}
+ }
+ 
+ irqreturn_t mt7996_irq_handler(int irq, void *dev_instance)
+ {
+ 	struct mt7996_dev *dev = dev_instance;
+ 
+ 	if (READ_ONCE(dev->recovery.failed))
+ 		return IRQ_NONE;
+ 
+ 	if (mtk_wed_device_active(&dev->mt76.mmio.wed))
+ 		mtk_wed_device_irq_set_mask(&dev->mt76.mmio.wed, 0);
+ 	else
+ 		mt76_wr(dev, MT_INT_MASK_CSR, 0);
