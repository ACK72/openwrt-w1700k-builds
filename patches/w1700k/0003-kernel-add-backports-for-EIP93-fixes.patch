 ...ure-eip93-correct-ecb-des-eip93-typo.patch | 28 +++++++++++++++++++
 1 file changed, 28 insertions(+)
 create mode 100644 target/linux/generic/backport-6.18/999-v7.0-crypto-inside-secure-eip93-correct-ecb-des-eip93-typo.patch

diff --git a/target/linux/generic/backport-6.18/999-v7.0-crypto-inside-secure-eip93-correct-ecb-des-eip93-typo.patch b/target/linux/generic/backport-6.18/999-v7.0-crypto-inside-secure-eip93-correct-ecb-des-eip93-typo.patch
