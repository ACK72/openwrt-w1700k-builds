+ 		.ivsize	= 0,
+ 		.base = {
+ 			.cra_name = "ecb(des)",
+-			.cra_driver_name = "ebc(des-eip93)",
++			.cra_driver_name = "ecb(des-eip93)",
+ 			.cra_priority = EIP93_CRA_PRIORITY,
+ 			.cra_flags = CRYPTO_ALG_ASYNC |
+ 					CRYPTO_ALG_KERN_DRIVER_ONLY,
