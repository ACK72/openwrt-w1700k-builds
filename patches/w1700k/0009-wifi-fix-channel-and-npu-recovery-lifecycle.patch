++				"beacon loss: band=%u link=%d age=%ums threshold=%ums scan=%d roc=%d tokens=%d\n",
++				phy->band_idx, link_id,
++				jiffies_to_msecs(jiffies - READ_ONCE(mlink->beacon_mon_last)),
++				jiffies_to_msecs(MT76_BEACON_MON_MAX_MISS * interval),
++				test_bit(MT76_SCANNING, &phy->state),
++				!!phy->roc_vif, READ_ONCE(phy->dev->token_count));
+ 			ieee80211_beacon_loss(vif);
++		}
+ 	}
