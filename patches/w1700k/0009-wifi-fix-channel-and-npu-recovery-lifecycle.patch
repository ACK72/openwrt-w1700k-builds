+ bool mt76_has_tx_pending(struct mt76_phy *phy)
+ {
+ 	struct mt76_queue *q;
+ 	int i;
+ 
+ 	for (i = 0; i < __MT_TXQ_MAX; i++) {
+ 		q = phy->q_tx[i];
+ 		if (q && q->queued)
+ 			return true;
+ 	}
+ 
+ 	if (atomic_read(&phy->mgmt_tx_pending))
+ 		return true;
+ 
+ 	return false;
+ }
+ EXPORT_SYMBOL_GPL(mt76_has_tx_pending);
