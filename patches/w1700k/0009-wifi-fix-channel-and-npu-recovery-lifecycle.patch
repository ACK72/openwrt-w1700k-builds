+ static void mt7996_remove_iter(void *data, u8 *mac, struct ieee80211_vif *vif)
+ {
+ 	struct wireless_dev *wdev = ieee80211_vif_to_wdev(vif);
+ 	struct mt7996_radio_data *rdata = data;
+ 
