diff --git a/package/kernel/mt76/patches/9998-wifi-mt76-mt7996-guard-null-sta-on-eapol-tx.patch b/package/kernel/mt76/patches/9998-wifi-mt76-mt7996-guard-null-sta-on-eapol-tx.patch
