+ 	if (!mt76_ppe_device_active(phy->dev))
+ 		return -EOPNOTSUPP;
+ 
+ 	return airoha_ppe_dev_setup_tc_block_cb(phy->dev->mmio.ppe_dev,
+ 						type_data);
+ }
