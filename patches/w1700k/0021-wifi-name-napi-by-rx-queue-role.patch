From: ACK72 <ACK72@users.noreply.github.com>
Subject: [PATCH] wifi: identify threaded NAPI by actual RX queue role

Reuse the Airoha named-NAPI registration API added by patch 0018.
Copy the role name at registration so /proc and recreated threads retain
it. Preserve callbacks, weights, threaded mode and DMA ownership.

diff --git a/package/kernel/mt76/Makefile b/package/kernel/mt76/Makefile
--- a/package/kernel/mt76/Makefile
+++ b/package/kernel/mt76/Makefile
@@ -1,7 +1,7 @@
 include $(TOPDIR)/rules.mk
 
 PKG_NAME:=mt76
-PKG_RELEASE=12
+PKG_RELEASE=13
 
 PKG_LICENSE:=BSD-3-Clause-Clear
 PKG_LICENSE_FILES:=
diff --git a/package/kernel/mt76/patches/9999-zzzz-mt76-napi-roles.patch b/package/kernel/mt76/patches/9999-zzzz-mt76-napi-roles.patch
new file mode 100644
--- /dev/null
+++ b/package/kernel/mt76/patches/9999-zzzz-mt76-napi-roles.patch
@@ -0,0 +1,345 @@
+From: ACK72 <ACK72@users.noreply.github.com>
+Subject: [PATCH] mt76: persist actual RX queue roles in threaded NAPI names
+
+--- a/dma.c
++++ b/dma.c
+@@ -1084,95 +1084,148 @@
+ 
+ 		if (more) {
+ 			q->rx_head = skb;
+ 			continue;
+ 		}
+ 
+ 		dev->drv->rx_skb(dev, q - dev->q_rx, skb, &info);
+ 		continue;
+ 
+ free_frag:
+ 		mt76_put_page_pool_buf(data, allow_direct);
+ 	}
+ 
+ 	mt76_dma_rx_fill(dev, q, true);
+ 	return done;
+ }
+ 
+ int mt76_dma_rx_poll(struct napi_struct *napi, int budget)
+ {
+ 	struct mt76_dev *dev;
+ 	int qid, done = 0, cur;
+ 	u64 diag_start;
+ 
+ 	dev = mt76_priv(napi->dev);
+ 	qid = napi - dev->napi;
+ 	diag_start = mt76_sta_diag_poll_begin(dev, qid);
+ 
+ 	rcu_read_lock();
+ 
+ 	do {
+ 		cur = mt76_dma_rx_process(dev, &dev->q_rx[qid], budget - done);
+ 		mt76_rx_poll_complete(dev, qid, napi);
+ 		done += cur;
+ 	} while (cur && done < budget);
+ 
+ 	rcu_read_unlock();
+ 
+ 	mt76_sta_diag_poll_end(dev, qid, diag_start, done, budget);
+ 	if (done < budget && napi_complete(napi))
+ 		dev->drv->rx_poll_complete(dev, qid);
+ 
+ 	return done;
+ }
+ EXPORT_SYMBOL_GPL(mt76_dma_rx_poll);
+ 
++/* Roles are mt76 RX queue identities, never allocation or NAPI ID order. */
++#if IS_ENABLED(CONFIG_ARCH_AIROHA)
++static const char *mt76_rx_queue_role(enum mt76_rxq_id qid)
++{
++	static const char * const roles[__MT_RXQ_MAX] = {
++		[MT_RXQ_MAIN] = "rx0",
++		[MT_RXQ_MCU] = "wm",
++		[MT_RXQ_MCU_WA] = "wa",
++		[MT_RXQ_BAND1] = "rx1",
++		[MT_RXQ_BAND1_WA] = "wa1",
++		[MT_RXQ_MAIN_WA] = "wa0",
++		[MT_RXQ_BAND2] = "rx2",
++		[MT_RXQ_BAND2_WA] = "wa2",
++		[MT_RXQ_RRO_BAND0] = "rro0",
++		[MT_RXQ_RRO_BAND1] = "rro1",
++		[MT_RXQ_RRO_BAND2] = "rro2",
++		[MT_RXQ_MSDU_PAGE_BAND0] = "pg0",
++		[MT_RXQ_MSDU_PAGE_BAND1] = "pg1",
++		[MT_RXQ_MSDU_PAGE_BAND2] = "pg2",
++		[MT_RXQ_TXFREE_BAND0] = "tf0",
++		[MT_RXQ_TXFREE_BAND1] = "tf1",
++		[MT_RXQ_TXFREE_BAND2] = "tf2",
++		[MT_RXQ_RRO_IND] = "ind",
++		[MT_RXQ_RRO_RXDMAD_C] = "rxd",
++		[MT_RXQ_NPU0] = "npu0",
++		[MT_RXQ_NPU1] = "npu1",
++	};
++
++	return (unsigned int)qid < ARRAY_SIZE(roles) ? roles[qid] : NULL;
++}
++
++#endif
++
++void mt76_rx_napi_add(struct mt76_dev *dev, enum mt76_rxq_id qid,
++		      int (*poll)(struct napi_struct *, int))
++{
++#if IS_ENABLED(CONFIG_ARCH_AIROHA)
++	const char *role = mt76_rx_queue_role(qid);
++	char name[IFNAMSIZ];
++
++	/* The Airoha kernel supplies persistent named NAPI registration.
++	 * Fall back rather than publish a truncated, ambiguous identity.
++	 */
++	if (is_mt7996(dev) && role && snprintf(name, sizeof(name), "napi/%s-%s",
++			     dev->napi_dev->name, role) < (int)sizeof(name)) {
++		netif_napi_add_weight_named(dev->napi_dev, &dev->napi[qid],
++					    poll, NAPI_POLL_WEIGHT, name);
++		return;
++	}
++#endif
++	netif_napi_add(dev->napi_dev, &dev->napi[qid], poll);
++}
++
+ static void
+ mt76_dma_rx_queue_init(struct mt76_dev *dev, enum mt76_rxq_id qid,
+ 		       int (*poll)(struct napi_struct *napi, int budget))
+ {
+-	netif_napi_add(dev->napi_dev, &dev->napi[qid], poll);
++	mt76_rx_napi_add(dev, qid, poll);
+ 	mt76_dma_rx_fill_buf(dev, &dev->q_rx[qid], false);
+ 	napi_enable(&dev->napi[qid]);
+ }
+ 
+ static int
+ mt76_dma_init(struct mt76_dev *dev,
+ 	      int (*poll)(struct napi_struct *napi, int budget))
+ {
+ 	struct mt76_dev **priv;
+ 	int i;
+ 
+ 	dev->napi_dev = alloc_netdev_dummy(sizeof(struct mt76_dev *));
+ 	if (!dev->napi_dev)
+ 		return -ENOMEM;
+ 
+ 	/* napi_dev private data points to mt76_dev parent, so, mt76_dev
+ 	 * can be retrieved given napi_dev
+ 	 */
+ 	priv = netdev_priv(dev->napi_dev);
+ 	*priv = dev;
+ 
+ 	dev->tx_napi_dev = alloc_netdev_dummy(sizeof(struct mt76_dev *));
+ 	if (!dev->tx_napi_dev) {
+ 		free_netdev(dev->napi_dev);
+ 		return -ENOMEM;
+ 	}
+ 	priv = netdev_priv(dev->tx_napi_dev);
+ 	*priv = dev;
+ 
+ 	snprintf(dev->napi_dev->name, sizeof(dev->napi_dev->name), "%s",
+ 		 wiphy_name(dev->hw->wiphy));
+ 	dev->napi_dev->threaded = 1;
+ 	init_completion(&dev->mmio.wed_reset);
+ 	init_completion(&dev->mmio.wed_reset_complete);
+ 
+ 	mt76_for_each_q_rx(dev, i) {
+ 		if (mt76_queue_is_wed_rro(&dev->q_rx[i]))
+ 			continue;
+ 
+ 		mt76_dma_rx_queue_init(dev, i, poll);
+ 	}
+ 
+ 	return 0;
+ }
+ 
