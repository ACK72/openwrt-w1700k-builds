{
  "luci-app-attendedsysupgrade": {
    "description": "Authenticated W1700K release upgrades",
    "read": {
      "file": {
        "/usr/libexec/w1700k-upgrade status": ["exec"],
        "/usr/libexec/w1700k-upgrade info": ["exec"]
      },
      "ubus": {"file": ["exec"]}
    },
    "write": {
      "file": {
        "/usr/libexec/w1700k-upgrade list": ["exec"],
        "/usr/libexec/w1700k-upgrade download *": ["exec"],
        "/usr/libexec/w1700k-upgrade install *": ["exec"]
      },
      "ubus": {"file": ["exec"]}
    }
  }
}
